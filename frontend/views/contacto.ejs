<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Contacto • TEXCOMMERCE Colombia</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&amp;family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
  <style>
    @layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
    }
    ::-webkit-scrollbar { display: none; }
  </style>
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-dim": "#dcdad4",
            "surface-container-highest": "#e5e2dc",
            "tertiary-container": "#1f1b15",
            "surface-container-low": "#f6f3ed",
            "surface": "#fcf9f3",
            "tertiary-fixed-dim": "#cec5bb",
            "primary-fixed": "#e7e1dc",
            "inverse-primary": "#cbc5c0",
            "outline-variant": "#cdc5bc",
            "on-primary-fixed": "#1d1b18",
            "secondary-fixed": "#ffdbcc",
            "background": "#fcf9f3",
            "tertiary-fixed": "#eae1d7",
            "surface-container": "#f0eee8",
            "surface-tint": "#615e5a",
            "primary-container": "#1d1b18",
            "on-error": "#ffffff",
            "on-surface": "#1c1c18",
            "on-surface-variant": "#4b463f",
            "outline": "#7c766e",
            "on-secondary-fixed-variant": "#713617",
            "primary": "#000000",
            "surface-variant": "#e5e2dc",
            "secondary-fixed-dim": "#ffb694",
            "on-tertiary-container": "#8a837a",
            "on-secondary-fixed": "#351000",
            "on-tertiary-fixed-variant": "#4b463f",
            "secondary-container": "#feaa82",
            "inverse-surface": "#31312d",
            "on-tertiary": "#ffffff",
            "secondary": "#8e4d2c",
            "on-background": "#1c1c18",
            "inverse-on-surface": "#f3f0ea",
            "on-error-container": "#93000a",
            "on-primary-fixed-variant": "#494643",
            "surface-bright": "#fcf9f3",
            "on-tertiary-fixed": "#1f1b15",
            "on-secondary-container": "#793c1d",
            "error": "#ba1a1a",
            "surface-container-lowest": "#ffffff",
            "on-secondary": "#ffffff",
            "surface-container-high": "#ebe8e2",
            "primary-fixed-dim": "#cbc5c0",
            "on-primary-container": "#87837f",
            "error-container": "#ffdad6",
            "on-primary": "#ffffff",
            "tertiary": "#000000"
          },
          fontFamily: {
            "spec-numeral": ["DM Sans"],
            "display-hero": ["Playfair Display"],
            "headline-sm": ["Playfair Display"],
            "display-hero-mobile": ["Playfair Display"],
            "body-lg": ["DM Sans"],
            "headline-lg": ["Playfair Display"],
            "headline-md": ["Playfair Display"],
            "body-sm": ["DM Sans"],
            "label-caps": ["DM Sans"],
            "body-md": ["DM Sans"]
          }
        }
      }
    }
  </script>
  <script src="/cart.js"></script>
</head>
<body class="bg-background font-body-md text-on-surface antialiased selection:bg-secondary-fixed selection:text-on-secondary-fixed">

  <!-- BARRA DE NAVEGACIÓN PRINCIPAL -->
  <header class="fixed top-0 left-0 right-0 w-full z-50 bg-surface/90 backdrop-blur-md border-b border-surface-variant">
    <!-- Franja Superior (Bogotá | ES / EN) -->
    <div class="w-full border-b border-surface-variant bg-surface-container-low/70 px-6 md:px-12">
      <div class="max-w-[1440px] mx-auto h-8 flex items-center justify-between text-on-surface-variant font-label-caps text-xs uppercase">
        <p class="truncate pr-4 tracking-wider"></p>
        <div class="flex items-center gap-4 shrink-0">
          <span class="text-on-surface-variant">Bogotá</span>
          <span class="text-outline-variant">|</span>
          <button class="hover:text-primary transition-colors focus:outline-none">ES / EN</button>
        </div>
      </div>
    </div>

    <div class="w-full px-6 md:px-12">
      <div class="max-w-[1440px] mx-auto h-20 flex items-center justify-between gap-6">
        <nav class="hidden lg:flex items-center gap-8 font-label-caps text-xs uppercase tracking-widest" data-active-classes="text-primary font-bold border-b border-primary pb-1">
          <a class="text-on-surface-variant hover:text-primary transition-colors" data-path="inicio" href="/">Inicio</a>
          <a class="text-on-surface-variant hover:text-primary transition-colors" data-path="catalogo" href="/catalogo">Catálogo</a>
          <a class="text-on-surface-variant hover:text-primary transition-colors" data-path="conocenos" href="/conocenos">Conócenos</a>
          <a aria-current="page" class="transition-colors text-primary font-bold border-b border-primary pb-1" data-path="contacto" href="/contacto">Contacto</a>
        </nav>
        <div class="flex items-center gap-2">
          <a class="flex items-center gap-3 focus:outline-none" data-path="inicio" href="/">
            <img alt="TEXCOMERCE" class="h-8 w-auto object-contain" src="/logo.jpg"/>
            <span class="font-headline-md text-2xl tracking-tight text-primary uppercase">TEXCOMERCE</span>
          </a>
        </div>
        <div class="flex items-center gap-6">
          <a class="flex items-center gap-1 font-label-caps text-xs uppercase text-on-surface-variant hover:text-primary transition-colors" data-path="dashboard" href="/login">
            <span class="material-symbols-outlined text-[20px]">account_circle</span>
            <span class="hidden sm:inline ml-1">Mi Cuenta</span>
          </a>
          <button class="bg-primary text-on-primary px-4 py-2 font-label-caps text-xs uppercase tracking-widest hover:bg-secondary transition-colors focus:outline-none flex items-center gap-2 shadow-sm relative" onclick="window.location.href='/carrito'">
            <span>Carrito</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="w-full pt-28 pb-20 bg-background">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 flex flex-col gap-16">

      <!-- ENCABEZADO DE CONTACTO -->
      <section class="max-w-3xl">
        <div class="inline-flex items-center gap-2 mb-3">
          <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
          <span class="font-label-caps text-xs uppercase tracking-widest text-secondary font-semibold">Atención al Cliente • Asesoría de Telas</span>
        </div>
        <h1 class="font-display-hero text-4xl sm:text-5xl text-primary tracking-tight leading-tight mb-4">
          Contáctanos.
        </h1>
        <p class="font-body-lg text-lg text-on-surface-variant leading-relaxed">
          ¿Tienes dudas sobre el metraje de tu tela, disponibilidad de tonos o necesitas información sobre envíos a tu ciudad? Comunícate directamente con nosotros o déjanos un mensaje.
        </p>
      </section>

      <!-- CANALES DIRECTOS Y CASILLA DE CORREO -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- COLUMNA IZQUIERDA: INFORMACIÓN DE CONTACTO -->
        <div class="lg:col-span-5 flex flex-col gap-6">
          
          <!-- Tarjeta WhatsApp / Teléfono -->
          <div class="bg-surface-container-lowest p-6 shadow-sm border-l-4 border-secondary flex flex-col justify-between">
            <div class="flex items-center gap-3 mb-3">
              <span class="material-symbols-outlined text-secondary text-2xl">chat</span>
              <h3 class="font-headline-sm text-xl text-primary">Línea Directa y WhatsApp</h3>
            </div>
            <p class="font-body-sm text-xs text-on-surface-variant mb-4">
              Atención inmediata para resolver consultas sobre pedidos, disponibilidad de stock y cálculo de metros.
            </p>
            <div class="space-y-2">
              <a href="https://wa.me/573118332763" target="_blank" class="flex items-center justify-between bg-surface-container-low hover:bg-surface-container-high px-4 py-3 transition-colors text-primary font-spec-numeral text-sm font-semibold">
                <span>+57 311 833 2763</span>
                <span class="font-label-caps text-[10px] text-secondary uppercase tracking-wider font-bold">Chatear por WhatsApp →</span>
              </a>
              <a href="tel:+573118332763" class="block text-center border border-outline-variant hover:bg-surface-container px-4 py-2.5 font-label-caps text-xs uppercase tracking-wider text-on-surface transition-colors">
                Llamar Directamente
              </a>
            </div>
          </div>

          <!-- Tarjeta Correo Electrónico -->
          <div class="bg-surface-container-lowest p-6 shadow-sm border-l-4 border-primary">
            <div class="flex items-center gap-3 mb-3">
              <span class="material-symbols-outlined text-primary text-2xl">mail</span>
              <h3 class="font-headline-sm text-xl text-primary">Correo de Contacto</h3>
            </div>
            <p class="font-body-sm text-xs text-on-surface-variant mb-3">
              Escríbenos para solicitudes formales, cotizaciones de gran volumen o confirmación de pedidos.
            </p>
            <a href="mailto:contacto@texcommerce.com" class="font-spec-numeral text-sm font-semibold text-primary hover:text-secondary transition-colors block">
              contacto@texcommerce.com
            </a>
          </div>

          <!-- Tarjeta Horario y Ubicación -->
          <div class="bg-surface-container-low p-6 shadow-sm space-y-4">
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary text-xl shrink-0 mt-0.5">location_on</span>
              <div>
                <h4 class="font-label-caps text-xs text-primary uppercase font-bold tracking-wider">Ubicación y Despachos</h4>
                <p class="font-body-sm text-xs text-on-surface-variant mt-0.5">
                  Sede en <strong>Bogotá, Colombia</strong>. Cobertura de envíos seguros a nivel nacional.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary text-xl shrink-0 mt-0.5">schedule</span>
              <div>
                <h4 class="font-label-caps text-xs text-primary uppercase font-bold tracking-wider">Horario de Atención</h4>
                <p class="font-body-sm text-xs text-on-surface-variant mt-0.5">
                  Lunes a Viernes: 8:00 a.m. – 6:00 p.m.<br/>
                  Sábados: 9:00 a.m. – 1:00 p.m.
                </p>
              </div>
            </div>
          </div>

        </div>

        <!-- COLUMNA DERECHA: CASILLA PARA ENVIAR CORREO DE CONTACTO -->
        <div class="lg:col-span-7 bg-surface-container-lowest p-8 md:p-10 shadow-sm">
          <div class="mb-6">
            <span class="font-label-caps text-xs text-secondary uppercase tracking-widest font-semibold block mb-1">Buzón Rápido</span>
            <h2 class="font-headline-lg text-2xl md:text-3xl text-primary">Envíanos un Correo de Consulta</h2>
            <p class="font-body-sm text-xs text-on-surface-variant mt-1">
              Ingresa tus datos y déjanos tu inquietud. Te responderemos a tu correo a la brevedad.
            </p>
          </div>

          <form id="contactEmailForm" onsubmit="handleContactSubmit(event)" class="space-y-5">
            <div>
              <label class="block font-label-caps text-xs text-on-surface-variant uppercase tracking-wider mb-2" for="userNombre">
                Tu Nombre Completo *
              </label>
              <input 
                type="text" 
                id="userNombre" 
                name="nombre" 
                required 
                placeholder="Ej. Juan Diego Osorio" 
                class="w-full bg-surface-container-low px-4 py-3 text-on-surface font-body-sm text-sm outline-none border border-transparent focus:border-primary transition-colors"
              />
            </div>

            <div>
              <label class="block font-label-caps text-xs text-on-surface-variant uppercase tracking-wider mb-2" for="userEmail">
                Tu Correo Electrónico de Contacto *
              </label>
              <input 
                type="email" 
                id="userEmail" 
                name="email" 
                required 
                placeholder="ejemplo@correo.com" 
                class="w-full bg-surface-container-low px-4 py-3 text-on-surface font-body-sm text-sm outline-none border border-transparent focus:border-primary transition-colors"
              />
            </div>

            <div>
              <label class="block font-label-caps text-xs text-on-surface-variant uppercase tracking-wider mb-2" for="userMensaje">
                Mensaje o Consulta sobre Telas *
              </label>
              <textarea 
                id="userMensaje" 
                name="mensaje" 
                rows="4" 
                required 
                placeholder="Escribe tu consulta sobre disponibilidad de tela, metros requeridos o asesoría..."
                class="w-full bg-surface-container-low p-4 text-on-surface font-body-sm text-sm outline-none border border-transparent focus:border-primary transition-colors"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full bg-primary text-on-primary py-3.5 font-label-caps text-xs uppercase tracking-widest hover:bg-secondary transition-colors shadow-sm flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-[18px]">send</span>
              <span>Enviar Correo de Contacto</span>
            </button>
          </form>

          <!-- Mensaje de confirmación tras enviar -->
          <div id="contactSuccessMsg" class="hidden mt-6 p-6 bg-surface-container-low border-l-4 border-secondary transition-all">
            <div class="flex items-center gap-2 mb-1">
              <span class="material-symbols-outlined text-secondary text-xl">check_circle</span>
              <h4 class="font-headline-sm text-lg text-primary">¡Mensaje Enviado con Éxito!</h4>
            </div>
            <p class="font-body-sm text-xs text-on-surface-variant">
              Hemos recibido tu correo de contacto. Uno de nuestros asesores de TEXCOMMERCE te responderá al correo proporcionado en el menor tiempo posible.
            </p>
          </div>
        </div>

      </section>

      <!-- SECCIÓN: PREGUNTAS FRECUENTES (FAQ) -->
      <section class="max-w-4xl mx-auto w-full pt-6">
        <div class="text-center mb-10">
          <span class="font-label-caps text-xs text-secondary uppercase tracking-widest font-semibold block mb-2">Resolución de Dudas</span>
          <h2 class="font-headline-lg text-3xl text-primary">Preguntas Frecuentes</h2>
        </div>

        <div class="space-y-4">
          
          <!-- FAQ 1 -->
          <div class="bg-surface-container-lowest p-6 shadow-sm cursor-pointer" onclick="toggleFaq(1)">
            <div class="flex items-center justify-between gap-4">
              <h3 class="font-headline-sm text-lg text-primary">
                ¿A partir de cuántos metros de tela puedo comprar?
              </h3>
              <span class="material-symbols-outlined text-outline transition-transform duration-300 shrink-0" id="faq-icon-1">expand_more</span>
            </div>
            <div class="hidden mt-4 pt-4 border-t border-surface-container font-body-sm text-sm md:text-[15px] text-on-surface-variant leading-relaxed" id="faq-body-1">
              En TEXCOMMERCE vendemos por metro lineal a partir de <strong class="text-primary font-semibold">1 metro de tela</strong>. Puedes añadir a tu bolsa la cantidad exacta de metros que necesites para tu molde o confección sin forzar mínimos de rollo.
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="bg-surface-container-lowest p-6 shadow-sm cursor-pointer" onclick="toggleFaq(2)">
            <div class="flex items-center justify-between gap-4">
              <h3 class="font-headline-sm text-lg text-primary">
                ¿Hacen envíos a toda Colombia y cuánto tiempo demora la entrega?
              </h3>
              <span class="material-symbols-outlined text-outline transition-transform duration-300 shrink-0" id="faq-icon-2">expand_more</span>
            </div>
            <div class="hidden mt-4 pt-4 border-t border-surface-container font-body-sm text-sm md:text-[15px] text-on-surface-variant leading-relaxed" id="faq-body-2">
              Sí, realizamos envíos nacionales a cualquier ciudad o municipio del país. Los pedidos se preparan en 24 a 48 horas hábiles con empaque sellado que protege el tejido contra humedad y polvo durante el transporte.
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="bg-surface-container-lowest p-6 shadow-sm cursor-pointer" onclick="toggleFaq(3)">
            <div class="flex items-center justify-between gap-4">
              <h3 class="font-headline-sm text-lg text-primary">
                ¿Qué medios de pago puedo utilizar en la tienda?
              </h3>
              <span class="material-symbols-outlined text-outline transition-transform duration-300 shrink-0" id="faq-icon-3">expand_more</span>
            </div>
            <div class="hidden mt-4 pt-4 border-t border-surface-container font-body-sm text-sm md:text-[15px] text-on-surface-variant leading-relaxed" id="faq-body-3">
              Aceptamos pagos electrónicos 100% seguros a través de Wompi, PSE (débito desde cualquier banco colombiano), tarjetas de crédito (Visa, Mastercard, American Express) y transferencias bancarias directas.
            </div>
          </div>

          <!-- FAQ 4 -->
          <div class="bg-surface-container-lowest p-6 shadow-sm cursor-pointer" onclick="toggleFaq(4)">
            <div class="flex items-center justify-between gap-4">
              <h3 class="font-headline-sm text-lg text-primary">
                ¿Los colores que veo en pantalla son iguales a la tela física?
              </h3>
              <span class="material-symbols-outlined text-outline transition-transform duration-300 shrink-0" id="faq-icon-4">expand_more</span>
            </div>
            <div class="hidden mt-4 pt-4 border-t border-surface-container font-body-sm text-sm md:text-[15px] text-on-surface-variant leading-relaxed" id="faq-body-4">
              Sí. Todas nuestras telas cuentan con una paleta estandarizada de 8 tonos oficiales, fotografiadas en estudio con iluminación neutra y sin filtros de oscurecimiento para asegurar que recibas el tono exacto que elegiste.
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- FOOTER UNIFICADO -->
  <footer class="w-full bg-surface-container-low border-t border-surface-variant text-on-surface-variant">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 pt-12 pb-8">
      <div class="flex flex-col md:flex-row items-start justify-between gap-8 pb-8 border-b border-surface-variant">
        <div>
          <a class="flex items-center gap-2 focus:outline-none mb-2" href="/">
            <img alt="TEXCOMERCE" class="h-8 w-auto object-contain" src="/logo.jpg"/>
            <span class="font-headline-md text-xl tracking-tight text-primary uppercase">TEXCOMERCE</span>
          </a>
          <p class="font-body-sm text-xs text-outline max-w-sm">
            Comercialización y distribución de telas seleccionadas por metro a nivel nacional.
          </p>
        </div>
        <div>
          <h4 class="font-label-caps text-xs uppercase tracking-widest text-primary mb-3">Navegación</h4>
          <ul class="space-y-2 font-body-sm text-xs">
            <li><a class="hover:text-primary transition-colors" href="/catalogo">Catálogo de Telas</a></li>
            <li><a class="hover:text-primary transition-colors" href="/conocenos">Conócenos</a></li>
            <li><a class="hover:text-primary transition-colors" href="/contacto">Contacto</a></li>
          </ul>
        </div>
      </div>
      <div class="pt-6 flex flex-col md:flex-row items-center justify-between gap-4 font-spec-numeral text-xs text-outline">
        <p>© 2026 TEXCOMMERCE Colombia. Todos los derechos reservados.</p>
        <div class="flex items-center gap-6 font-label-caps text-[10px] uppercase tracking-widest">
          <a class="hover:text-primary transition-colors" href="/terminos-venta">Términos de Venta</a>
          <a class="hover:text-primary transition-colors" href="/aviso-privacidad">Aviso de Privacidad</a>
          <a class="hover:text-primary transition-colors" href="/composicion-telas">Composición de Telas</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // Enviar formulario de contacto
    function handleContactSubmit(e) {
      e.preventDefault();
      const form = document.getElementById('contactEmailForm');
      const successBox = document.getElementById('contactSuccessMsg');
      if (form && successBox) {
        form.classList.add('opacity-40', 'pointer-events-none');
        successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // Toggle de Preguntas Frecuentes (FAQ)
    function toggleFaq(id) {
      const body = document.getElementById('faq-body-' + id);
      const icon = document.getElementById('faq-icon-' + id);
      if (body && icon) {
        const isHidden = body.classList.contains('hidden');
        if (isHidden) {
          body.classList.remove('hidden');
          icon.classList.add('rotate-180');
        } else {
          body.classList.add('hidden');
          icon.classList.remove('rotate-180');
        }
      }
    }
  </script>
</body>
</html>
