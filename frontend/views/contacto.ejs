<script>
  function scrollToForm(locationName) {
    const formSection = document.getElementById('formulario-prescripcion');
    if (formSection) {
      formSection.scrollIntoView({ behavior: 'smooth' });
      const requestTypeSelect = document.getElementById('requestType');
      if (requestTypeSelect) {
        if (locationName.includes('Chapinero')) {
          requestTypeSelect.value = 'cita-Chapinero';
        } else if (locationName.includes('Roma')) {
          requestTypeSelect.value = 'cita-roma';
        }
      }
    }
  }

  function handleFormSubmit(event) {
    event.preventDefault();
    const form = document.getElementById('contractForm');
    const successBox = document.getElementById('formSuccess');
    if (form && successBox) {
      form.classList.add('opacity-40', 'pointer-events-none');
      successBox.classList.remove('hidden');
      successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function toggleFaq(index) {
    const body = document.getElementById('faq-body-' + index);
    const icon = document.getElementById('faq-icon-' + index);
    if (body && icon) {
      const isHidden = body.classList.contains('hidden');
      if (isHidden) {
        body.classList.remove('hidden');
        icon.classList.add('rotate-180');
      } else {
        body.classList.add('hidden');
        icon.classList.remove('rotate-180');
      }
    }
  }
</script></main></div></body></html>






