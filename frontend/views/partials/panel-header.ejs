<%# Cabecera común del panel: los enlaces dependen del rol de la sesión %>
<% const sesionActual = typeof usuario !== 'undefined' ? usuario : null; %>
<% const esStaff = sesionActual && (sesionActual.rol === 'admin' || sesionActual.rol === 'moderador'); %>
<% const enlace = 'font-label-caps text-xs uppercase tracking-wider text-outline hover:text-primary transition-colors whitespace-nowrap'; %>
<header class="fixed top-0 left-0 right-0 h-16 bg-surface/90 backdrop-blur-md border-b border-surface-variant z-40 px-4 sm:px-8 flex items-center justify-between gap-4">
    <span class="font-headline-sm text-headline-sm text-primary uppercase shrink-0">TEXCOMERCE</span>
    <%# En pantallas angostas la navegación se desplaza horizontalmente %>
    <nav class="flex-1 min-w-0 overflow-x-auto flex items-center gap-4 [scrollbar-width:none]">
        <a class="<%= enlace %>" href="/catalogo">Catálogo</a>
        <% if (sesionActual) { %>
            <a class="<%= enlace %>" href="/mi-panel">Mi panel</a>
            <a class="<%= enlace %>" href="/pedidos">Mis pedidos</a>
            <a class="<%= enlace %>" href="/cuenta">Mi cuenta</a>
        <% } %>
        <% if (esStaff) { %>
            <span class="text-outline-variant">/</span>
            <a class="<%= enlace %>" href="/menu">Panel</a>
            <a class="<%= enlace %>" href="/usuarios">Usuarios</a>
            <a class="<%= enlace %>" href="/pedidos/todos">Todos los pedidos</a>
        <% } %>
    </nav>
    <div class="flex items-center gap-4 shrink-0">
        <% if (sesionActual) { %>
            <span class="hidden md:inline font-body-sm text-xs text-primary font-medium"><%= sesionActual.nombre %> · <span class="uppercase text-outline"><%= sesionActual.rol %></span></span>
            <a href="/logout" title="Cerrar sesión" class="font-label-caps text-xs uppercase tracking-wider text-outline hover:text-error transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[18px]">logout</span><span class="hidden sm:inline">Cerrar Sesión</span>
            </a>
        <% } else { %>
            <a href="/login" class="<%= enlace %>">Iniciar sesión</a>
        <% } %>
    </div>
</header>
