<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Editar Usuario - TEXCOMERCE</title>
    <!-- Fuentes y Iconos oficiales -->
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&amp;family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
    <style>
      @layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}
      ::-webkit-scrollbar{display:none;}
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "surface-dim": "#dcdad4",
            "surface-container-highest": "#e5e2dc",
            "tertiary-container": "#1f1b15",
            "surface-container-low": "#f6f3ed",
            "surface": "#fcf9f3",
            "background": "#fcf9f3",
            "surface-container": "#f0eee8",
            "surface-variant": "#e5e2dc",
            "on-surface": "#1c1c18",
            "on-surface-variant": "#4b463f",
            "outline": "#7c766e",
            "outline-variant": "#cdc5bc",
            "primary": "#000000",
            "on-primary": "#ffffff",
            "secondary": "#8e4d2c",
            "on-secondary": "#ffffff",
            "error": "#ba1a1a",
            "surface-container-lowest": "#ffffff",
            "surface-container-high": "#ebe8e2"
          },
          "fontFamily": {
            "spec-numeral": ["DM Sans"],
            "headline-sm": ["Playfair Display"],
            "headline-md": ["Playfair Display"],
            "body-md": ["DM Sans"],
            "label-caps": ["DM Sans"]
          }
        }
      }
    }</script>
</head>
<body class="bg-background font-body-md text-on-surface antialiased">

    <!-- Cabecera Superior -->
    <header class="fixed top-0 left-0 right-0 h-16 bg-surface/90 backdrop-blur-md border-b border-surface-variant z-40 px-8 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <span class="font-headline-sm text-headline-sm text-primary uppercase">TEXCOMERCE</span>
            <span class="text-outline-variant">/</span>
            <a class="font-label-caps text-xs uppercase tracking-wider text-outline hover:text-primary transition-colors" href="/usuarios">← Volver a Usuarios</a>
            <span class="text-outline-variant">/</span>
            <span class="font-label-caps text-xs uppercase tracking-widest text-primary font-semibold">Editar Cuenta</span>
        </div>
        <div class="flex items-center gap-6">
            <span class="font-body-sm text-xs text-primary font-medium">Administrador</span>
            <a href="/logout" class="font-label-caps text-xs uppercase tracking-wider text-outline hover:text-error transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">logout</span> Cerrar Sesión
            </a>
        </div>
    </header>

    <!-- Cuerpo Principal (Formulario Centrado Estilizado) -->
    <main class="relative pt-28 px-8 pb-16 w-full max-w-2xl mx-auto">
        
        <div class="mb-6">
            <span class="font-label-caps text-xs uppercase tracking-widest text-outline">Panel Administrativo</span>
            <h1 class="font-headline-md text-2xl text-primary font-semibold mt-1">Editar Usuario</h1>
        </div>

        <% if (error) { %>
            <div class="bg-error/10 border border-error/20 text-error p-4 mb-6 font-body-sm text-xs">
                <%= error %>
            </div>
        <% } %>

        <div class="bg-surface-container-lowest border border-surface-variant p-8 shadow-sm">
            <form action="/usuarios/editar" method="POST" class="space-y-5">
                
                <!-- ID oculto del usuario -->
                <input type="hidden" name="id_usuario" value="<%= usuario.id_usuario %>">

                <div class="flex flex-col gap-1.5">
                    <label for="nombre" class="font-label-caps text-xs uppercase text-on-surface-variant">Nombre</label>
                    <input type="text" id="nombre" name="nombre" value="<%= usuario.nombre %>" required class="bg-surface-container-low border border-surface-variant px-4 py-2.5 text-on-surface font-body-sm text-xs outline-none focus:border-primary transition-colors">
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="correo" class="font-label-caps text-xs uppercase text-on-surface-variant">Correo Electrónico</label>
                    <input type="email" id="correo" name="correo" value="<%= usuario.correo %>" required class="bg-surface-container-low border border-surface-variant px-4 py-2.5 text-on-surface font-body-sm text-xs outline-none focus:border-primary transition-colors">
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="contrasena" class="font-label-caps text-xs uppercase text-on-surface-variant">Contraseña <span class="text-outline font-normal lowercase">(dejar en blanco para no cambiarla)</span></label>
                    <input type="password" id="contrasena" name="contrasena" placeholder="Nueva contraseña opcional" class="bg-surface-container-low border border-surface-variant px-4 py-2.5 text-on-surface font-body-sm text-xs outline-none focus:border-primary transition-colors">
                </div>

                <div class="flex flex-col gap-1.5">
                    <label for="rol" class="font-label-caps text-xs uppercase text-on-surface-variant">Rol de Usuario</label>
                    <input type="text" id="rol" name="rol" value="<%= usuario.rol %>" required class="bg-surface-container-low border border-surface-variant px-4 py-2.5 text-on-surface font-body-sm text-xs outline-none focus:border-primary transition-colors">
                </div>

                <div class="flex items-center gap-4 pt-4 border-t border-surface-variant">
                    <button type="submit" class="bg-primary hover:bg-secondary text-on-primary px-6 py-3 font-label-caps text-xs uppercase tracking-widest transition-colors shadow-sm flex items-center gap-2 cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">update</span> Actualizar Usuario
                    </button>
                    <a href="/usuarios" class="font-label-caps text-xs uppercase tracking-wider text-outline hover:text-primary transition-colors">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>

    </main>

</body>
</html>


