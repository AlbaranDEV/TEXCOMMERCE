</div></main></div>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById('cart-items-container');
  const emptyState = document.getElementById('cart-empty-state');
  const bottomActions = document.getElementById('cart-bottom-actions');
  const headerCount = document.getElementById('cart-header-count');
  const headerMeters = document.getElementById('cart-header-meters');
  const subtotalEl = document.getElementById('cart-summary-subtotal');
  const metersEl = document.getElementById('cart-summary-meters');
  const ivaEl = document.getElementById('cart-summary-iva');
  const totalEl = document.getElementById('cart-summary-total');
  const checkoutBtn = document.getElementById('btn-proceed-checkout');
  const clearBtn = document.getElementById('btn-clear-cart');

  function renderCart() {
    if (!window.TexcommerceCart) return;
    const cart = window.TexcommerceCart.getCart();
    const totals = window.TexcommerceCart.getTotals();

    if (headerCount) headerCount.innerText = totals.itemCount;
    if (headerMeters) headerMeters.innerText = totals.totalMetros.toFixed(1);

    if (subtotalEl) subtotalEl.innerText = window.TexcommerceCart.formatCOP(totals.subtotal);
    if (metersEl) metersEl.innerText = totals.totalMetros.toFixed(1) + ' m';
    if (ivaEl) ivaEl.innerText = window.TexcommerceCart.formatCOP(totals.iva);
    if (totalEl) totalEl.innerText = window.TexcommerceCart.formatCOP(totals.total);

    if (cart.length === 0) {
      if (emptyState) emptyState.classList.remove('hidden');
      if (container) container.innerHTML = '';
      if (bottomActions) bottomActions.classList.add('hidden');
      if (checkoutBtn) {
        checkoutBtn.classList.add('opacity-50', 'cursor-not-allowed');
        checkoutBtn.disabled = true;
      }
      return;
    }

    if (emptyState) emptyState.classList.add('hidden');
    if (bottomActions) bottomActions.classList.remove('hidden');
    if (checkoutBtn) {
      checkoutBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      checkoutBtn.disabled = false;
    }

    if (!container) return;
    container.innerHTML = '';

    cart.forEach(item => {
      const article = document.createElement('article');
      article.className = 'bg-surface-container-lowest border border-surface-variant p-6 lg:p-8 transition-all hover:border-primary/40 shadow-sm';
      article.innerHTML = `
        <div class="flex flex-col sm:flex-row gap-6">
          <div class="w-full sm:w-44 h-48 shrink-0 bg-surface-container overflow-hidden relative group">
            <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="${item.imagen || '/telas/seda_natural.jpg'}" alt="${item.nombre}"/>
            <span class="absolute bottom-2 left-2 bg-primary/90 text-on-primary font-spec-numeral text-[10px] px-2 py-0.5 uppercase tracking-widest">
              ${item.codigo}
            </span>
          </div>
          <div class="flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <span class="font-label-caps text-label-caps uppercase text-outline tracking-wider">${item.fibra || 'Fibra Noble'}</span>
                  <h3 class="font-headline-sm text-headline-sm text-primary mt-1">${item.nombre}</h3>
                  <div class="flex items-center gap-2 mt-1.5 font-spec-numeral text-xs text-primary">
                    <span class="w-3 h-3 rounded-full inline-block border border-black/15 shadow-xs" style="background-color: ${item.colorHex || '#EAE4D9'};"></span>
                    <span class="font-semibold uppercase tracking-wider">Tono: ${item.color}</span>
                  </div>
                </div>
                <div class="text-right">
                  <p class="font-headline-sm text-lg text-primary font-semibold">${window.TexcommerceCart.formatCOP(item.subtotal)}</p>
                  <p class="font-spec-numeral text-[11px] text-on-surface-variant">${window.TexcommerceCart.formatCOP(item.precio_metro)} / metro</p>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-2 py-2.5 my-3 border-y border-surface-variant bg-surface-container-low/50 px-3 text-xs">
                <div>
                  <span class="font-label-caps text-[10px] text-outline uppercase block">Ancho Útil</span>
                  <span class="font-spec-numeral text-primary font-medium">150 cm continuo</span>
                </div>
                <div>
                  <span class="font-label-caps text-[10px] text-outline uppercase block">Corte</span>
                  <span class="font-spec-numeral text-primary font-medium">Mesa Atelier Certificada</span>
                </div>
              </div>
            </div>
            <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class="font-label-caps text-[11px] text-outline uppercase tracking-wider">Metraje:</span>
                <div class="flex items-center border border-primary bg-surface shadow-xs">
                  <button type="button" class="btn-decrease w-8 h-8 flex items-center justify-center text-primary hover:bg-surface-container-high transition-colors cursor-pointer" data-key="${item.key}" aria-label="Restar 0.5 metros">
                    <span class="material-symbols-outlined text-[16px]">remove</span>
                  </button>
                  <span class="px-3 font-spec-numeral text-spec-numeral text-primary font-semibold min-w-[64px] text-center">
                    ${item.metros.toFixed(1)} <span class="text-[10px] font-normal text-outline">m</span>
                  </span>
                  <button type="button" class="btn-increase w-8 h-8 flex items-center justify-center text-primary hover:bg-surface-container-high transition-colors cursor-pointer" data-key="${item.key}" aria-label="Sumar 0.5 metros">
                    <span class="material-symbols-outlined text-[16px]">add</span>
                  </button>
                </div>
                <span class="font-body-sm text-xs text-secondary italic">Rollo continuo</span>
              </div>
              <button type="button" class="btn-remove font-body-sm text-xs text-error/80 hover:text-error transition-colors flex items-center gap-1 cursor-pointer" data-key="${item.key}">
                <span class="material-symbols-outlined text-[16px]">delete</span>
                <span>Retirar Partida</span>
              </button>
            </div>
          </div>
        </div>
      `;
      container.appendChild(article);
    });

    // Eventos de botones +/- y retirar
    container.querySelectorAll('.btn-decrease').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-key');
        window.TexcommerceCart.adjustMeters(key, -0.5);
      });
    });

    container.querySelectorAll('.btn-increase').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-key');
        window.TexcommerceCart.adjustMeters(key, 0.5);
      });
    });

    container.querySelectorAll('.btn-remove').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-key');
        window.TexcommerceCart.removeItem(key);
      });
    });
  }

  // Evento para vaciar bolsa
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (confirm('¿Deseas vaciar todas las telas de tu bolsa de compras?')) {
        window.TexcommerceCart.clearCart();
      }
    });
  }

  // Evento para proceder al checkout
  if (checkoutBtn) {
    checkoutBtn.addEventListener('click', () => {
      const cart = window.TexcommerceCart.getCart();
      if (cart.length === 0) {
        alert('Tu bolsa de compras está vacía.');
        return;
      }
      window.location.href = '/checkout';
    });
  }

  // Evento para añadir telas recomendadas oficiales del catálogo
  document.querySelectorAll('.btn-add-recommended').forEach(btn => {
    btn.addEventListener('click', () => {
      const codigo = btn.getAttribute('data-codigo');
      const nombre = btn.getAttribute('data-nombre');
      const precio = parseFloat(btn.getAttribute('data-precio')) || 0;
      const fibra = btn.getAttribute('data-fibra');
      const color = btn.getAttribute('data-color');
      const colorHex = btn.getAttribute('data-color-hex');
      const imagen = btn.getAttribute('data-imagen');

      window.TexcommerceCart.addToCart({
        codigo,
        nombre,
        color,
        colorHex,
        precio_metro: precio,
        metros: 1.0,
        imagen,
        fibra,
        ancho_cm: 150
      });
    });
  });

  // Render inicial y sincronización con cambios
  renderCart();
  window.addEventListener('cartUpdated', renderCart);
});
</script>
</body></html>






