  data-codigo="#ALG-06"
  data-nombre="Algodón Orgánico Suave"
  data-precio="24000"
  data-fibra="100% Algodón"
  data-color="Hueso"
  data-color-hex="#FAF7F0"
  data-imagen="/telas/algodon_organico.jpg">
