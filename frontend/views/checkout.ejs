<script>
    function switchPayment(method) {
      const ccDetails = document.getElementById('cc-details');
      const speiDetails = document.getElementById('spei-details');
      
      if (method === 'cc') {
        ccDetails.classList.remove('hidden');
        speiDetails.classList.add('hidden');
      } else if (method === 'spei') {
        ccDetails.classList.add('hidden');
        speiDetails.classList.remove('hidden');
      } else {
        ccDetails.classList.add('hidden');
        speiDetails.classList.add('hidden');
      }
    }

    function toggleCfdi(show) {
      const fields = document.getElementById('cfdi-fields');
      if (show) {
        fields.classList.remove('hidden');
      } else {
        fields.classList.add('hidden');
      }
    }
  </script>

  <!-- Modal de Pedido Confirmado -->
  <div id="order-success-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-surface-container-lowest border border-primary max-w-md w-full p-8 shadow-2xl flex flex-col items-center text-center space-y-5">
      <div class="w-16 h-16 bg-primary text-on-primary rounded-full flex items-center justify-center shadow-lg">
        <span class="material-symbols-outlined text-[36px]">verified</span>
      </div>
      <div class="space-y-1">
        <span class="font-label-caps text-xs text-secondary uppercase tracking-widest font-bold">Base de Datos Actualizada</span>
        <h2 class="font-headline-lg text-2xl text-primary font-semibold">¡Pedido Registrado con Éxito!</h2>
        <p class="font-body-sm text-on-surface-variant text-xs pt-1">
          Tus partidas han quedado guardadas en la tabla oficial <code class="bg-surface-container-low px-1.5 py-0.5 rounded font-mono text-primary font-bold">pedido</code> de MySQL.
        </p>
      </div>
      <div class="w-full bg-surface-container-low p-4 border border-surface-variant text-left space-y-2 font-body-sm text-xs">
        <div class="flex justify-between">
          <span class="text-outline">Confirmación:</span>
          <span id="modal-order-ids" class="font-spec-numeral font-bold text-primary">Partidas procesadas</span>
        </div>
        <div class="flex justify-between">
          <span class="text-outline">Cliente:</span>
          <span class="font-medium text-primary"><%= usuario ? (usuario.nombre + ' ' + (usuario.apellidos || '')) : 'Cliente' %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-outline">Total Oficial:</span>
          <span id="modal-order-total" class="font-spec-numeral font-bold text-secondary text-sm">$0 COP</span>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 w-full pt-2">
        <a href="/catalogo" class="flex-1 bg-surface-container hover:bg-surface-container-high text-primary py-3 px-4 font-label-caps text-xs uppercase tracking-widest text-center transition-colors border border-outline-variant">
          Catálogo
        </a>
        <a href="/menu" class="flex-1 bg-primary hover:bg-secondary text-on-primary py-3 px-4 font-label-caps text-xs uppercase tracking-widest text-center transition-colors shadow-sm">
          Ver Mis Pedidos
        </a>
      </div>
    </div>
  </div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const isUserLoggedIn = <%= usuario ? 'true' : 'false' %>;
  const itemsContainer = document.getElementById('checkout-items-list');
  const itemsCountEl = document.getElementById('checkout-items-count');
  const subtotalEl = document.getElementById('checkout-subtotal');
  const metersEl = document.getElementById('checkout-meters');
  const ivaEl = document.getElementById('checkout-iva');
  const totalEl = document.getElementById('checkout-total');
  const confirmBtn = document.getElementById('btn-confirm-order');
  const confirmText = document.getElementById('btn-confirm-text');

  function renderCheckoutSummary() {
    if (!window.TexcommerceCart) return;
    const cart = window.TexcommerceCart.getCart();
    const totals = window.TexcommerceCart.getTotals();

    if (itemsCountEl) itemsCountEl.innerText = `${totals.itemCount} ÍTEMS`;
    if (subtotalEl) subtotalEl.innerText = window.TexcommerceCart.formatCOP(totals.subtotal);
    if (metersEl) metersEl.innerText = `${totals.totalMetros.toFixed(1)} m`;
    if (ivaEl) ivaEl.innerText = window.TexcommerceCart.formatCOP(totals.iva);
    if (totalEl) totalEl.innerText = window.TexcommerceCart.formatCOP(totals.total);

    if (cart.length === 0) {
      if (itemsContainer) {
        itemsContainer.innerHTML = `
          <div class="bg-surface-container-lowest p-6 text-center border border-dashed border-outline-variant space-y-2">
            <p class="font-body-sm text-xs text-on-surface-variant">Tu bolsa de compras está vacía.</p>
            <a href="/catalogo" class="font-label-caps text-xs text-primary underline font-bold uppercase tracking-wider inline-block">Ir al Catálogo</a>
          </div>
        `;
      }
      if (confirmBtn) {
        confirmBtn.disabled = true;
        confirmBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
      return;
    }

    if (!itemsContainer) return;
    itemsContainer.innerHTML = '';

    cart.forEach(item => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-3 bg-surface-container-lowest p-3 border border-surface-variant/50 shadow-xs';
      row.innerHTML = `
        <img class="w-14 h-16 object-cover shrink-0" src="${item.imagen || '/telas/seda_natural.jpg'}" alt="${item.nombre}"/>
        <div class="flex flex-col flex-1 min-w-0">
          <div class="flex items-center justify-between">
            <span class="font-label-caps text-[10px] text-secondary uppercase font-semibold">${item.metros.toFixed(1)} Metros</span>
            <span class="font-spec-numeral text-xs font-bold text-primary">${window.TexcommerceCart.formatCOP(item.subtotal)}</span>
          </div>
          <h4 class="font-headline-sm text-xs text-primary truncate mt-0.5">${item.nombre}</h4>
          <div class="flex items-center gap-2 text-outline font-body-sm text-[10px] mt-0.5">
            <span class="font-semibold text-primary">${item.codigo}</span>
            <span>•</span>
            <span>Tono: ${item.color}</span>
            <span>•</span>
            <span>${window.TexcommerceCart.formatCOP(item.precio_metro)}/m</span>
          </div>
        </div>
      `;
      itemsContainer.appendChild(row);
    });

    if (confirmBtn) {
      confirmBtn.disabled = false;
      confirmBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    }
  }

  // Manejo de confirmación de pedido
  if (confirmBtn) {
    confirmBtn.addEventListener('click', async () => {
      const cart = window.TexcommerceCart ? window.TexcommerceCart.getCart() : [];
      if (cart.length === 0) {
        alert('No hay telas en tu bolsa de compras.');
        return;
      }

      if (!isUserLoggedIn) {
        alert('Debes iniciar sesión con tu cuenta para asociar la orden y guardarla en la base de datos.');
        window.location.href = '/login?redirect=/checkout';
        return;
      }

      try {
        confirmBtn.disabled = true;
        if (confirmText) confirmText.innerText = 'Registrando pedido en MySQL...';

        const totals = window.TexcommerceCart.getTotals();
        const payload = {
          items: cart.map(i => ({
            producto: `${i.nombre} (${i.codigo}) - Tono ${i.color}`,
            cantidad: i.metros,
            subtotal: i.subtotal
          })),
          total: totals.total
        };

        const response = await fetch('/checkout/confirmar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Error al procesar el pedido en el servidor');
        }

        // Éxito: mostrar modal y limpiar carrito
        const modal = document.getElementById('order-success-modal');
        const modalOrderIds = document.getElementById('modal-order-ids');
        const modalOrderTotal = document.getElementById('modal-order-total');

        if (modalOrderIds) {
          modalOrderIds.innerText = `${data.pedidosCreados || cart.length} partida(s) registradas`;
        }
        if (modalOrderTotal) {
          modalOrderTotal.innerText = window.TexcommerceCart.formatCOP(totals.total);
        }
        if (modal) {
          modal.classList.remove('hidden');
        }

        // Limpiar el carrito de compras tras compra exitosa
        window.TexcommerceCart.clearCart();

      } catch (err) {
        console.error('Error al confirmar pedido:', err);
        alert('Ocurrió un error al guardar el pedido: ' + err.message);
        confirmBtn.disabled = false;
        if (confirmText) confirmText.innerText = 'Confirmar y Registrar Pedido en MySQL';
      }
    });
  }

  renderCheckoutSummary();
  window.addEventListener('cartUpdated', renderCheckoutSummary);
});
</script>
