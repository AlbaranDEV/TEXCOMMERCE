<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/panel-head', { titulo: todos ? 'Todos los pedidos' : 'Mis pedidos' }) %>
</head>
<body class="bg-background font-body-md text-on-surface antialiased">
    <%- include('partials/panel-header') %>

    <main class="relative pt-24 px-8 pb-16 w-full max-w-7xl mx-auto">
        <div class="mb-8 pb-4 border-b border-surface-variant">
            <span class="font-label-caps text-xs uppercase tracking-widest text-outline"><%= todos ? 'Supervisión' : 'Historial de compras' %></span>
            <h1 class="font-headline-md text-2xl text-primary font-semibold mt-1"><%= todos ? 'Todos los pedidos' : 'Mis pedidos' %></h1>
        </div>

        <div class="bg-surface-container-lowest border border-surface-variant shadow-sm overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-surface-variant font-label-caps text-[11px] text-outline uppercase tracking-wider">
                        <th class="py-3.5 px-6">Pedido</th>
                        <% if (todos) { %><th class="py-3.5 px-6">Cliente</th><% } %>
                        <th class="py-3.5 px-6">Producto</th>
                        <th class="py-3.5 px-6">Metros</th>
                        <th class="py-3.5 px-6 text-right">Total</th>
                        <th class="py-3.5 px-6 text-right">Fecha</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-variant font-body-sm text-xs">
                    <% pedidos.forEach(pedido => { %>
                        <tr class="hover:bg-surface-container-low/50 transition-colors">
                            <td class="py-4 px-6 font-spec-numeral font-semibold text-primary">#<%= pedido.id_pedido %></td>
                            <% if (todos) { %><td class="py-4 px-6 text-on-surface-variant"><%= pedido.cliente || 'Cuenta eliminada' %></td><% } %>
                            <td class="py-4 px-6 font-medium text-primary"><%= pedido.producto %></td>
                            <td class="py-4 px-6 text-on-surface-variant"><%= pedido.cantidad %></td>
                            <td class="py-4 px-6 text-right text-primary">$<%= Number(pedido.total || 0).toLocaleString('es-CO') %></td>
                            <td class="py-4 px-6 text-right text-on-surface-variant"><%= new Date(pedido.fecha).toLocaleDateString('es-CO') %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <% if (pedidos.length === 0) { %>
                <div class="p-12 text-center space-y-2">
                    <span class="material-symbols-outlined text-outline text-[32px]">receipt_long</span>
                    <p class="font-body-sm text-sm text-on-surface-variant">Todavía no hay pedidos.</p>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
