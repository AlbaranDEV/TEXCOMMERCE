<script>
  // Simple Quantity Counter Micro-interactions for Fabric Cards
  document.querySelectorAll('article').forEach(card => {
    const decBtn = card.querySelector('button:has-text("-")') || card.querySelectorAll('div.col-span-4 button')[0];
    const incBtn = card.querySelector('button:has-text("+")') || card.querySelectorAll('div.col-span-4 button')[1];
    const qtySpan = card.querySelector('div.col-span-4 span');

    if (decBtn && incBtn && qtySpan) {
      decBtn.addEventListener('click', (e) => {
        e.preventDefault();
        let val = parseFloat(qtySpan.innerText);
        if (val > 1.0) {
          val -= 1.0;
          qtySpan.innerText = val.toFixed(1) + 'm';
        }
      });

      incBtn.addEventListener('click', (e) => {
        e.preventDefault();
        let val = parseFloat(qtySpan.innerText);
        val += 1.0;
        qtySpan.innerText = val.toFixed(1) + 'm';
      });
    }

    // Color Swatch Disc Switching simulation
    const swatchDots = card.querySelectorAll('.absolute.bottom-space-sm span[class*="rounded-full"]');
    swatchDots.forEach(dot => {
      dot.addEventListener('click', () => {
        swatchDots.forEach(d => d.classList.remove('ring-1', 'ring-primary', 'ring-offset-1'));
        dot.classList.add('ring-1', 'ring-primary', 'ring-offset-1');
      });
    });
  });
</script></main><footer class="w-full bg-surface-container-low border-t border-surface-variant text-on-surface-variant mt-space-2xl"><div class="max-w-[1440px] mx-auto px-margin-desktop pt-space-2xl pb-space-xl"><div class="grid grid-cols-1 md:grid-cols-12 gap-gutter-desktop pb-space-2xl border-b border-surface-variant"><div class="md:col-span-5 pr-space-xl"><span class="font-headline-md text-headline-md text-primary tracking-tight block mb-space-xs uppercase">Cuaderno Textil</span><p class="font-body-md text-body-md text-on-surface-variant mb-space-lg leading-relaxed">Monografías trimestrales sobre botánica de fibras, hilaturas nobles, teñido vegetal y disponibilidad de rollos de archivo para proyectos contract.</p><form class="flex flex-col sm:flex-row gap-0 max-w-md"><input class="bg-surface-container-lowest border border-outline-variant px-space-md py-3 text-on-surface font-body-sm text-body-sm placeholder:text-outline focus:border-primary outline-none flex-1" placeholder="arquitectura@estudio.com" type="email"/><button class="bg-primary text-on-primary font-label-caps text-label-caps uppercase tracking-widest px-space-lg py-3 hover:bg-secondary transition-colors focus:outline-none" type="button">Suscribir</button></form><span class="font-label-caps text-[10px] text-outline mt-2 block tracking-wider uppercase">Privacidad respetada. Emisión mensual rigurosa.</span></div><div class="md:col-span-2 sm:col-span-4"><h4 class="font-label-caps text-label-caps uppercase tracking-widest text-primary mb-space-md">Colecciones</h4><ul class="space-y-space-sm font-body-sm text-body-sm"><li class="hover:text-primary transition-colors"><a data-path="catalogo" href="/catalogo">Linos Europeos</a></li><li class="hover:text-primary transition-colors"><a data-path="catalogo" href="/catalogo">Sedas Salvajes</a></li><li class="hover:text-primary transition-colors"><a data-path="catalogo" href="/catalogo">Lana Merino</a></li><li class="hover:text-primary transition-colors"><a data-path