<!-- Toast Notification flotante para feedback de pedido -->
<div id="toast-notification" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 bg-primary text-on-primary px-5 py-4 shadow-2xl flex items-center gap-3 border-l-4 border-secondary max-w-md">
  <span class="material-symbols-outlined text-secondary text-[26px]">check_circle</span>
  <div class="flex flex-col">
    <span class="font-label-caps text-[10px] uppercase tracking-widest text-secondary-fixed">Metraje añadido al pedido</span>
    <span id="toast-message" class="font-body-sm text-sm text-on-primary font-medium"></span>
  </div>
</div>

<script>
  // Manejo interactivo de cada tarjeta de espécimen de tela
  document.querySelectorAll('article[data-fabric]').forEach(card => {
    // 1. Contador de Metraje (+ / -) y cálculo dinámico de precio
    const qtyButtons = card.querySelectorAll('div.col-span-4 button');
    const decBtn = qtyButtons[0];
    const incBtn = qtyButtons[1];
    const qtySpan = card.querySelector('div.col-span-4 span');
    const priceDisplay = card.querySelector('.fabric-price-display');
    const priceSuffix = card.querySelector('.fabric-price-suffix');
    const unitPrice = parseFloat(card.getAttribute('data-unit-price') || '0');

    function updatePrice(val) {
      if (priceDisplay && unitPrice > 0) {
        const total = Math.round(unitPrice * val);
        priceDisplay.innerText = '$' + total.toLocaleString('es-CO');
        if (priceSuffix) {
          if (val === 1.0) {
            priceSuffix.innerText = ' COP / metro';
          } else {
            priceSuffix.innerText = ` COP (${val.toFixed(1)}m)`;
          }
        }
      }
    }

    if (decBtn && incBtn && qtySpan) {
      decBtn.addEventListener('click', (e) => {
        e.preventDefault();
        let val = parseFloat(qtySpan.innerText);
        if (val > 1.0) {
          val -= 1.0;
          qtySpan.innerText = val.toFixed(1) + 'm';
          updatePrice(val);
        }
      });

      incBtn.addEventListener('click', (e) => {
        e.preventDefault();
        let val = parseFloat(qtySpan.innerText);
        val += 1.0;
        qtySpan.innerText = val.toFixed(1) + 'm';
        updatePrice(val);
      });
    }

    // 2. Selección de Color dentro de la tela
    const swatches = card.querySelectorAll('.color-swatch-btn');
    const colorLabel = card.querySelector('.selected-color-name');
    const indicatorDot = card.querySelector('.color-indicator-dot');
    const indicatorText = card.querySelector('.color-indicator-text');

    swatches.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const color = btn.getAttribute('data-color');
        const hex = btn.getAttribute('data-hex');

        // Anillo activo para el botón presionado
        swatches.forEach(s => {
          s.classList.remove('ring-2', 'ring-primary', 'ring-offset-2');
          s.classList.add('ring-1', 'ring-black/10');
        });
        btn.classList.remove('ring-1', 'ring-black/10');
        btn.classList.add('ring-2', 'ring-primary', 'ring-offset-2');

        // Actualizar etiqueta de color en la ficha
        if (colorLabel) {
          colorLabel.innerText = color;
        }

        // Actualizar indicador sobre la fotografía
        if (indicatorDot) {
          indicatorDot.style.backgroundColor = hex;
        }
        if (indicatorText) {
          indicatorText.innerText = color;
        }
      });
    });

    // 3. Botón Añadir Metraje con Toast feedback dinámico
    const addBtn = card.querySelector('button.col-span-8');
    if (addBtn) {
      addBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const fabricTitle = card.querySelector('h3')?.innerText || 'Tela seleccionada';
        const chosenColor = card.querySelector('.selected-color-name')?.innerText || 'Crudo';
        const metraje = qtySpan?.innerText || '1.0m';
        const currentVal = parseFloat(metraje) || 1.0;
        const total = Math.round(unitPrice * currentVal);
        const totalFormatted = '$' + total.toLocaleString('es-CO');

        showToast(`${metraje} de ${fabricTitle} (${chosenColor}) por ${totalFormatted} COP`);
      });
    }
  });

  // Función Toast de confirmación
  function showToast(message) {
    const toast = document.getElementById('toast-notification');
    const msgEl = document.getElementById('toast-message');
    if (!toast || !msgEl) return;

    msgEl.innerText = message;
    toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
    toast.classList.add('translate-y-0', 'opacity-100');

    if (window.toastTimer) clearTimeout(window.toastTimer);
    window.toastTimer = setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
    }, 3500);
  }

  // 4. Búsqueda y filtrado inteligente en tiempo real
  const searchInput = document.getElementById('catalog-search-input');
  const searchClearBtn = document.getElementById('catalog-search-clear');
  const noResultsBox = document.getElementById('no-search-results');
  const searchQueryText = document.getElementById('search-query-text');
  const resetSearchBtn = document.getElementById('reset-search-btn');
  const countLabel = document.getElementById('catalog-count-label');
  const paginationStrip = document.getElementById('pagination-strip');
  const fabricCards = Array.from(document.querySelectorAll('article[data-fabric]'));

  function normalizeText(str) {
    if (!str) return '';
    return str
      .toString()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  function filterCatalog(term) {
    const cleanTerm = normalizeText(term);

    // Mostrar u ocultar botón de limpiar (✕)
    if (searchClearBtn) {
      if (term && term.trim().length > 0) {
        searchClearBtn.classList.remove('hidden');
      } else {
        searchClearBtn.classList.add('hidden');
      }
    }

    let matchCount = 0;
    const searchWords = cleanTerm.split(/\s+/).filter(w => w.length > 0);

    fabricCards.forEach(card => {
      if (searchWords.length === 0) {
        card.classList.remove('hidden');
        matchCount++;
      } else {
        const keywords = normalizeText(
          (card.getAttribute('data-keywords') || '') + ' ' +
          (card.getAttribute('data-fabric') || '') + ' ' +
          (card.innerText || '')
        );

        const matches = searchWords.every(word => keywords.includes(word));
        if (matches) {
          card.classList.remove('hidden');
          matchCount++;
        } else {
          card.classList.add('hidden');
        }
      }
    });

    if (matchCount === 0 && searchWords.length > 0) {
      if (noResultsBox) noResultsBox.classList.remove('hidden');
      if (searchQueryText) searchQueryText.innerText = term.trim();
      if (paginationStrip) paginationStrip.classList.add('hidden');
    } else {
      if (noResultsBox) noResultsBox.classList.add('hidden');
      if (paginationStrip) paginationStrip.classList.remove('hidden');
    }

    if (countLabel) {
      if (searchWords.length > 0) {
        countLabel.innerText = `Mostrando ${matchCount} de ${fabricCards.length} telas para "${term.trim()}"`;
      } else {
        countLabel.innerText = `Mostrando registros 1 – ${fabricCards.length} de ${fabricCards.length} telas en catálogo`;
      }
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      filterCatalog(e.target.value);
    });

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        searchInput.value = '';
        filterCatalog('');
      }
    });
  }

  function clearSearch() {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    filterCatalog('');
    const url = new URL(window.location);
    url.searchParams.delete('q');
    url.searchParams.delete('buscar');
    window.history.replaceState({}, '', url.pathname);
  }

  if (searchClearBtn) {
    searchClearBtn.addEventListener('click', clearSearch);
  }

  if (resetSearchBtn) {
    resetSearchBtn.addEventListener('click', clearSearch);
  }

  // Leer parámetro ?q= o ?buscar= al cargar la página (desde inicio u otra página)
  const urlParams = new URLSearchParams(window.location.search);
  const initialQuery = urlParams.get('q') || urlParams.get('buscar');
  if (initialQuery && searchInput) {
    searchInput.value = initialQuery;
    filterCatalog(initialQuery);
  }

  // 5. Filtros rápidos interactivos por botones de telas reales
  const pillButtons = Array.from(document.querySelectorAll('.catalog-pill-btn'));
  function setActivePill(activeFilter) {
    pillButtons.forEach(btn => {
      const f = btn.getAttribute('data-filter');
      const isMatch = (activeFilter === 'all' && f === 'all') || (activeFilter && f && activeFilter.toLowerCase().includes(f.toLowerCase()));
      if (isMatch) {
        btn.classList.add('bg-primary', 'text-on-primary', 'shadow-sm', 'active');
        btn.classList.remove('bg-surface-container-lowest', 'text-on-surface');
      } else {
        btn.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm', 'active');
        btn.classList.add('bg-surface-container-lowest', 'text-on-surface');
      }
    });
  }

  pillButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      if (filter === 'all') {
        if (searchInput) searchInput.value = '';
        filterCatalog('');
        setActivePill('all');
      } else {
        if (searchInput) searchInput.value = filter;
        filterCatalog(filter);
        setActivePill(filter);
      }
    });
  });

  // 6. Ordenamiento en tiempo real (por precio menor/mayor o por nombre A-Z)
  const sortSelect = document.getElementById('catalog-sort');
  const fabricGrid = document.getElementById('fabric-grid');
  const originalOrder = Array.from(fabricCards);

  if (sortSelect && fabricGrid) {
    sortSelect.addEventListener('change', () => {
      const sortVal = sortSelect.value;
      const sortedCards = Array.from(fabricCards);

      if (sortVal === 'price-asc') {
        sortedCards.sort((a, b) => parseFloat(a.getAttribute('data-unit-price') || 0) - parseFloat(b.getAttribute('data-unit-price') || 0));
      } else if (sortVal === 'price-desc') {
        sortedCards.sort((a, b) => parseFloat(b.getAttribute('data-unit-price') || 0) - parseFloat(a.getAttribute('data-unit-price') || 0));
      } else if (sortVal === 'name-asc') {
        sortedCards.sort((a, b) => (a.getAttribute('data-fabric') || '').localeCompare(b.getAttribute('data-fabric') || ''));
      } else if (sortVal === 'name-desc') {
        sortedCards.sort((a, b) => (b.getAttribute('data-fabric') || '').localeCompare(a.getAttribute('data-fabric') || ''));
      } else {
        // 'default': orden original
        sortedCards.sort((a, b) => originalOrder.indexOf(a) - originalOrder.indexOf(b));
      }

      // Re-insertar en el contenedor en el orden ordenado antes del mensaje de no resultados
      sortedCards.forEach(card => {
        if (noResultsBox) {
          fabricGrid.insertBefore(card, noResultsBox);
        } else {
          fabricGrid.appendChild(card);
        }
      });
    });
  }
