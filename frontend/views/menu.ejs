<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1.0" name="viewport"/><title>Panel de Administración - TEXCOMERCE</title><link href="https://fonts.googleapis.com" rel="preconnect"/><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&amp;family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;display=swap" rel="stylesheet"/><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config = {
  darkMode: "class",
  theme: {
    extend: {
      "colors": {
        "surface-dim": "#dcdad4",
        "surface-container-highest": "#e5e2dc",
        "tertiary-container": "#1f1b15",
        "surface-container-low": "#f6f3ed",
        "surface": "#fcf9f3",
        "tertiary-fixed-dim": "#cec5bb",
        "primary-fixed": "#e7e1dc",
        "inverse-primary": "#cbc5c0",
        "outline-variant": "#cdc5bc",
        "on-primary-fixed": "#1d1b18",
        "secondary-fixed": "#ffdbcc",
        "background": "#fcf9f3",
        "tertiary-fixed": "#eae1d7",
        "surface-container": "#f0eee8",
        "surface-tint": "#615e5a",
        "primary-container": "#1d1b18",
        "on-error": "#ffffff",
        "on-surface": "#1c1c18",
        "on-surface-variant": "#4b463f",
        "outline": "#7c766e",
        "on-secondary-fixed-variant": "#713617",
        "primary": "#000000",
        "surface-variant": "#e5e2dc",
        "secondary-fixed-dim": "#ffb694",
        "on-tertiary-container": "#8a837a",
        "on-secondary-fixed": "#351000",
        "on-tertiary-fixed-variant": "#4b463f",
        "secondary-container": "#feaa82",
        "inverse-surface": "#31312d",
        "on-tertiary": "#ffffff",
        "secondary": "#8e4d2c",
        "on-background": "#1c1c18",
        "inverse-on-surface": "#f3f0ea",
        "on-error-container": "#93000a",
        "on-primary-fixed-variant": "#494643",
        "surface-bright": "#fcf9f3",
        "on-tertiary-fixed": "#1f1b15",
        "on-secondary-container": "#793c1d",
        "error": "#ba1a1a",
        "surface-container-lowest": "#ffffff",
        "on-secondary": "#ffffff",
        "surface-container-high": "#ebe8e2",
        "primary-fixed-dim": "#cbc5c0",
        "on-primary-container": "#87837f",
        "error-container": "#ffdad6",
        "on-primary": "#ffffff",
        "tertiary": "#000000"
      },
      "borderRadius": {
        "DEFAULT": "0.25rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "full": "9999px"
      },
      "spacing": {
        "space-md": "1rem",
        "space-sm": "0.5rem",
        "space-lg": "1.5rem",
        "space-xs": "0.25rem",
        "margin-tablet": "2.5rem",
        "margin-desktop": "4rem",
        "margin": "1.25rem",
        "gutter-desktop": "2.5rem",
        "space-2xl": "4rem",
        "space-xl": "2.5rem",
        "gutter": "1.5rem"
      },
      "fontFamily": {
        "spec-numeral": ["DM Sans"],
        "display-hero": ["Playfair Display"],
        "headline-sm": ["Playfair Display"],
        "display-hero-mobile": ["Playfair Display"],
        "body-lg": ["DM Sans"],
        "headline-lg": ["Playfair Display"],
        "headline-md": ["Playfair Display"],
        "body-sm": ["DM Sans"],
        "label-caps": ["DM Sans"],
        "body-md": ["DM Sans"],
        "headline-lg-mobile": ["Playfair Display"]
      },
      "fontSize": {
        "spec-numeral": ["12px", {"lineHeight": "18px", "letterSpacing": "0.04em", "fontWeight": "500"}],
        "display-hero": ["56px", {"lineHeight": "64px", "letterSpacing": "-0.02em", "fontWeight": "400"}],
        "headline-sm": ["22px", {"lineHeight": "30px", "letterSpacing": "0.01em", "fontWeight": "500"}],
        "display-hero-mobile": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.01em", "fontWeight": "400"}],
        "body-lg": ["18px", {"lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "400"}],
        "headline-lg": ["40px", {"lineHeight": "48px", "letterSpacing": "-0.01em", "fontWeight": "400"}],
        "headline-md": ["28px", {"lineHeight": "36px", "letterSpacing": "0em", "fontWeight": "400"}],
        "body-sm": ["13px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "400"}],
        "label-caps": ["11px", {"lineHeight": "16px", "letterSpacing": "0.12em", "fontWeight": "600"}],
        "body-md": ["15px", {"lineHeight": "24px", "letterSpacing": "0em", "fontWeight": "400"}],
        "headline-lg-mobile": ["28px", {"lineHeight": "36px", "letterSpacing": "0em", "fontWeight": "400"}]
      }
    }
  }
}</script></head>
<%
    // Panel de administración (moderador y admin). Todos los valores vienen de la base de datos.
    const esAdmin = usuario.rol === 'admin';
    const cop = (valor) => '$' + Math.round(Number(valor) || 0).toLocaleString('es-CO');
    const fecha = (valor) => valor ? new Date(valor).toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
    const fechaHora = (valor) => valor ? new Date(valor).toLocaleString('es-CO', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '—';
    const staffActivo = sesiones.filter(s => s.rol !== 'usuario').length;
    const tarjeta = 'bg-surface-container-low p-5 rounded-none shadow-sm';
    const seccion = 'bg-surface-container-low p-6 sm:p-8 rounded-none shadow-sm scroll-mt-24';
    const etiqueta = 'font-label-caps text-label-caps uppercase tracking-widest text-outline';
    const avisos = {
        'sesion-cerrada': 'La sesión se cerró correctamente. El usuario deberá iniciar sesión de nuevo.',
        'sesion-error': 'No se pudo cerrar la sesión: ' + (detalleAviso || 'inténtalo de nuevo.')
    };
%>
<body class="bg-background font-body-md text-on-surface antialiased">

<!-- Cabecera -->
<header class="fixed top-0 left-0 right-0 h-16 bg-surface/90 backdrop-blur-md border-b border-surface-variant z-40 px-4 sm:px-8 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4 min-w-0">
        <a class="font-label-caps text-label-caps uppercase tracking-wider text-outline hover:text-primary transition-colors whitespace-nowrap" href="/catalogo">← Volver al Atelier</a>
        <span class="text-outline-variant hidden sm:inline">/</span>
        <span class="hidden sm:inline font-label-caps text-label-caps uppercase tracking-widest text-primary font-semibold whitespace-nowrap">Panel de Administración</span>
    </div>
    <div class="flex items-center gap-5 shrink-0">
        <a href="/pedidos/exportar.csv" class="flex items-center gap-1 font-label-caps text-label-caps uppercase tracking-wider text-outline hover:text-primary transition-colors" title="Descargar todos los pedidos en CSV">
            <span class="material-symbols-outlined text-[18px]">download</span><span class="hidden md:inline">Exportar pedidos</span>
        </a>
        <span class="hidden md:inline font-body-sm text-xs text-primary font-medium"><%= usuario.nombre %> · <span class="uppercase text-outline"><%= usuario.rol %></span></span>
        <a href="/logout" class="text-outline hover:text-error transition-colors" title="Cerrar sesión"><span class="material-symbols-outlined text-[20px]">logout</span></a>
    </div>
</header>

<main class="relative pt-24 px-4 sm:px-8 pb-16 w-full max-w-[1440px] mx-auto">
<div class="grid grid-cols-12 gap-6 lg:gap-gutter-desktop">

<!-- Columna izquierda -->
<div class="col-span-12 lg:col-span-3">
<div class="flex flex-col gap-6 lg:sticky lg:top-24">
    <!-- Sesión -->
    <div class="bg-surface-container-low p-6 rounded-none shadow-sm flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-primary text-on-primary flex items-center justify-center font-headline-sm text-headline-sm shrink-0">
            <%= (usuario.nombre || 'A').charAt(0).toUpperCase() %>
        </div>
        <div class="min-w-0 flex flex-col">
            <span class="font-label-caps text-label-caps uppercase tracking-widest text-secondary font-semibold">Sesión Iniciada</span>
            <h2 class="font-headline-sm text-headline-sm text-primary truncate"><%= usuario.nombre %></h2>
            <p class="font-body-sm text-body-sm text-on-surface-variant capitalize"><%= usuario.rol %></p>
        </div>
    </div>

    <!-- Navegación -->
    <nav class="bg-surface-container-low rounded-none shadow-sm flex flex-col p-2 space-y-1">
        <% [
            ['#resumen', 'insights', 'Resumen'],
            ['#sesiones', 'devices', 'Sesiones activas', sesiones.length],
            ['#ventas', 'monitoring', 'Ventas'],
            ['#pedidos', 'receipt_long', 'Historial de pedidos'],
            ['#inventario', 'inventory_2', 'Inventario de telas', inventario.filter(t => t.stockBajo).length || null],
            ['#cuentas', 'group', 'Cuentas registradas'],
            ['#cumplimiento', 'shield_person', 'Ley 1581'],
            ['/catalogo', 'storefront', 'Ver tienda']
        ].forEach(([href, icono, texto, contador]) => { %>
            <a href="<%= href %>" class="w-full flex items-center justify-between px-4 py-3 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors">
                <span class="flex items-center gap-3 font-body-md text-body-md"><span class="material-symbols-outlined text-[18px]"><%= icono %></span><%= texto %></span>
                <% if (contador) { %><span class="font-spec-numeral text-[11px] bg-secondary text-on-secondary px-2 py-0.5 rounded-full"><%= contador %></span><% } else { %><span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span><% } %>
            </a>
        <% }) %>
        <a href="/logout" class="w-full flex items-center justify-between px-4 py-3 text-on-surface-variant hover:bg-surface-container-high hover:text-error transition-colors">
            <span class="flex items-center gap-3 font-body-md text-body-md"><span class="material-symbols-outlined text-[18px]">logout</span>Cerrar Sesión</span>
            <span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span>
        </a>
    </nav>

    <p class="font-body-sm text-[11px] text-outline px-1">Datos en tiempo real · consultados el <%= fechaHora(generado) %></p>
</div>
</div>

<!-- Columna principal -->
<div class="col-span-12 lg:col-span-9 flex flex-col gap-8">

    <% if (aviso && avisos[aviso]) { %>
        <div class="<%= aviso === 'sesion-cerrada' ? 'bg-surface-container-high text-primary' : 'bg-error-container text-on-error-container' %> px-5 py-3 font-body-sm text-body-sm"><%= avisos[aviso] %></div>
    <% } %>

    <!-- Indicadores -->
    <section id="resumen" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 scroll-mt-24">
        <div class="<%= tarjeta %>">
            <div class="flex justify-between items-start mb-3"><span class="<%= etiqueta %>">Ventas totales</span><span class="material-symbols-outlined text-outline text-[20px]">payments</span></div>
            <p class="font-headline-md text-headline-md text-primary tracking-tight"><%= cop(ventas.totalVentas) %></p>
            <p class="mt-3 font-body-sm text-[11px] text-on-surface-variant">
                Este mes: <%= cop(ventas.mesActual.total) %>
                <% if (ventas.variacion !== null) { %>
                    <span class="<%= ventas.variacion >= 0 ? 'text-secondary' : 'text-error' %>">· <%= ventas.variacion >= 0 ? '+' : '' %><%= ventas.variacion %>% vs mes anterior</span>
                <% } %>
            </p>
        </div>
        <div class="<%= tarjeta %>">
            <div class="flex justify-between items-start mb-3"><span class="<%= etiqueta %>">Compras</span><span class="material-symbols-outlined text-outline text-[20px]">shopping_bag</span></div>
            <p class="font-headline-md text-headline-md text-primary tracking-tight"><%= ventas.numeroCompras %></p>
            <p class="mt-3 font-body-sm text-[11px] text-on-surface-variant"><%= ventas.numeroPartidas %> productos · <%= ventas.clientesCompradores %> cliente(s)</p>
        </div>
        <div class="<%= tarjeta %>">
            <div class="flex justify-between items-start mb-3"><span class="<%= etiqueta %>">Ticket promedio</span><span class="material-symbols-outlined text-outline text-[20px]">receipt</span></div>
            <p class="font-headline-md text-headline-md text-primary tracking-tight"><%= cop(ventas.ticketPromedio) %></p>
            <p class="mt-3 font-body-sm text-[11px] text-on-surface-variant">Promedio por compra</p>
        </div>
        <div class="<%= tarjeta %>">
            <div class="flex justify-between items-start mb-3"><span class="<%= etiqueta %>">Sesiones activas</span><span class="material-symbols-outlined text-outline text-[20px]">devices</span></div>
            <p class="font-headline-md text-headline-md text-primary tracking-tight"><%= sesiones.length %></p>
            <p class="mt-3 font-body-sm text-[11px] text-on-surface-variant"><%= sesiones.length - staffActivo %> cliente(s) · <%= staffActivo %> del equipo</p>
        </div>
    </section>

    <!-- Sesiones activas -->
    <section id="sesiones" class="<%= seccion %>">
        <div class="flex flex-wrap items-end justify-between gap-2 mb-6">
            <div>
                <h3 class="font-headline-md text-headline-md text-primary">Sesiones activas</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Usuarios con sesión abierta en este momento.<% if (esAdmin) { %> Puedes cerrar una sesión sospechosa.<% } %></p>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[640px]">
                <thead>
                    <tr class="bg-surface-container-high/60 font-label-caps text-label-caps text-outline uppercase tracking-wider">
                        <th class="py-3 px-4">Usuario</th>
                        <th class="py-3 px-4">Rol</th>
                        <th class="py-3 px-4">Inicio</th>
                        <% if (esAdmin) { %><th class="py-3 px-4">IP / Navegador</th><% } %>
                        <th class="py-3 px-4">Expira</th>
                        <% if (esAdmin) { %><th class="py-3 px-4 text-right">Acción</th><% } %>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-variant font-body-sm text-body-sm">
                    <% sesiones.forEach(s => { %>
                        <tr>
                            <td class="py-3 px-4"><p class="text-primary font-medium"><%= s.nombre %></p><p class="text-[11px] text-outline"><%= s.correo %></p></td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[10px] uppercase font-semibold tracking-wider <%= s.rol === 'admin' ? 'bg-primary text-on-primary' : s.rol === 'moderador' ? 'bg-secondary-fixed text-on-secondary-fixed' : 'bg-surface-container text-primary' %>"><%= s.rol %></span></td>
                            <td class="py-3 px-4 text-on-surface-variant"><%= s.inicio ? fechaHora(s.inicio) : 'Sin registro' %></td>
                            <% if (esAdmin) { %><td class="py-3 px-4 text-on-surface-variant"><p><%= s.ip || '—' %></p><p class="text-[11px] text-outline"><%= s.navegador || '' %></p></td><% } %>
                            <td class="py-3 px-4 text-on-surface-variant"><%= fechaHora(s.expira) %></td>
                            <% if (esAdmin) { %>
                                <td class="py-3 px-4 text-right">
                                    <% if (s.actual) { %>
                                        <span class="font-label-caps text-[10px] uppercase tracking-wider text-secondary">Tu sesión</span>
                                    <% } else { %>
                                        <form action="/admin/sesiones/cerrar" method="POST" class="inline">
                                            <input type="hidden" name="ref" value="<%= s.ref %>">
                                            <button type="submit" class="font-label-caps text-[11px] uppercase tracking-wider text-error hover:opacity-80">Cerrar sesión</button>
                                        </form>
                                    <% } %>
                                </td>
                            <% } %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            <% if (sesiones.length === 0) { %><p class="py-8 text-center font-body-sm text-body-sm text-on-surface-variant">No hay sesiones activas.</p><% } %>
        </div>
    </section>

    <!-- Ventas -->
    <section id="ventas" class="grid grid-cols-1 xl:grid-cols-5 gap-8 scroll-mt-24">
        <div class="xl:col-span-3 <%= seccion %>">
            <h3 class="font-headline-md text-headline-md text-primary">Ventas por mes</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant mb-6">Últimos 6 meses, en pesos colombianos (sin IVA).</p>
            <div class="flex items-end gap-3 h-48">
                <% ventas.meses.forEach(mes => { const altura = ventas.maximoMes ? Math.max(2, Math.round(mes.total / ventas.maximoMes * 100)) : 2; %>
                    <div class="flex-1 h-full flex flex-col items-center gap-2" title="<%= mes.etiqueta %>: <%= cop(mes.total) %> en <%= mes.pedidos %> producto(s)">
                        <span class="h-4 font-spec-numeral text-[10px] text-on-surface-variant whitespace-nowrap"><%= mes.total ? cop(mes.total) : '' %></span>
                        <%# Área fija para la barra: la etiqueta no le quita altura %>
                        <div class="relative w-full flex-1">
                            <div class="absolute bottom-0 left-0 right-0 <%= mes.total ? 'bg-secondary' : 'bg-surface-variant' %>" style="height: <%= altura %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
            <div class="flex gap-3 mt-2 border-t border-surface-variant pt-2">
                <% ventas.meses.forEach(mes => { %><span class="flex-1 text-center font-label-caps text-[10px] uppercase text-outline"><%= mes.etiqueta %></span><% }) %>
            </div>
        </div>
        <div class="xl:col-span-2 <%= seccion %>">
            <h3 class="font-headline-md text-headline-md text-primary">Telas más vendidas</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant mb-6">Por ingresos totales.</p>
            <% if (ventas.telasTop.length === 0) { %>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Aún no hay ventas registradas.</p>
            <% } %>
            <ul class="space-y-4">
                <% ventas.telasTop.forEach(tela => { %>
                    <li>
                        <div class="flex justify-between gap-3 font-body-sm text-body-sm"><span class="text-primary truncate"><%= tela.nombre %></span><span class="text-on-surface-variant whitespace-nowrap"><%= cop(tela.total) %></span></div>
                        <div class="h-1.5 bg-surface-variant mt-1.5"><div class="h-full bg-primary" style="width: <%= Math.round(tela.total / ventas.telasTop[0].total * 100) %>%"></div></div>
                        <p class="font-body-sm text-[11px] text-outline mt-1"><%= tela.partidas %> venta(s)</p>
                    </li>
                <% }) %>
            </ul>
        </div>
    </section>

    <!-- Historial de pedidos -->
    <section id="pedidos" class="<%= seccion %>">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
            <div>
                <h3 class="font-headline-md text-headline-md text-primary">Historial de Pedidos</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Últimos <%= pedidos.length %> productos vendidos<%= periodo === '30d' ? ' en los últimos 30 días' : periodo === 'anio' ? ' este año' : '' %>.</p>
            </div>
            <form method="GET" action="/menu#pedidos" class="flex items-center gap-3">
                <select name="periodo" class="bg-surface-container-highest border-none py-2 pl-3 pr-8 font-body-sm text-body-sm text-on-surface rounded-none focus:ring-0">
                    <option value="todos" <%= periodo === 'todos' ? 'selected' : '' %>>Todos los periodos</option>
                    <option value="30d" <%= periodo === '30d' ? 'selected' : '' %>>Últimos 30 días</option>
                    <option value="anio" <%= periodo === 'anio' ? 'selected' : '' %>>Este año</option>
                </select>
                <button type="submit" class="flex items-center gap-1 bg-surface-container-highest px-3 py-2 font-label-caps text-label-caps uppercase text-primary hover:bg-surface-variant transition-colors">
                    <span class="material-symbols-outlined text-[16px]">tune</span> Filtrar
                </button>
            </form>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[640px]">
                <thead>
                    <tr class="bg-surface-container-high/60 font-label-caps text-label-caps text-outline uppercase tracking-wider">
                        <th class="py-3 px-4">Orden</th>
                        <th class="py-3 px-4">Fecha</th>
                        <th class="py-3 px-4">Cliente</th>
                        <th class="py-3 px-4">Telas & metraje</th>
                        <th class="py-3 px-4 text-right">Inversión</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-variant font-body-sm text-body-sm">
                    <% pedidos.forEach(p => { %>
                        <tr>
                            <td class="py-3 px-4 font-spec-numeral font-semibold text-primary">#<%= p.id_pedido %></td>
                            <td class="py-3 px-4 text-on-surface-variant whitespace-nowrap"><%= fecha(p.fecha) %></td>
                            <td class="py-3 px-4"><p class="text-primary"><%= p.cliente || 'Cuenta eliminada' %></p><p class="text-[11px] text-outline"><%= p.correo || '' %></p></td>
                            <td class="py-3 px-4 text-primary"><%= p.producto %></td>
                            <td class="py-3 px-4 text-right font-semibold text-primary whitespace-nowrap"><%= cop(p.total) %> <span class="text-[10px] text-outline font-normal">COP</span></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            <% if (pedidos.length === 0) { %><p class="py-8 text-center font-body-sm text-body-sm text-on-surface-variant">No hay pedidos en este periodo.</p><% } %>
        </div>
        <div class="flex flex-wrap justify-end gap-6 mt-4">
            <a href="/pedidos/todos" class="font-label-caps text-label-caps uppercase tracking-wider text-outline hover:text-primary">Ver todos los pedidos →</a>
            <a href="/pedidos/exportar.csv" class="font-label-caps text-label-caps uppercase tracking-wider text-outline hover:text-primary">Exportar CSV ↓</a>
        </div>
    </section>

    <!-- Inventario -->
    <section id="inventario" class="<%= seccion %>">
        <h3 class="font-headline-md text-headline-md text-primary">Inventario de telas</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-6">Stock registrado en la tabla de telas. Se resaltan las telas con menos de 20 m.</p>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[560px]">
                <thead>
                    <tr class="bg-surface-container-high/60 font-label-caps text-label-caps text-outline uppercase tracking-wider">
                        <th class="py-3 px-4">Código</th>
                        <th class="py-3 px-4">Tela</th>
                        <th class="py-3 px-4">Fibra</th>
                        <th class="py-3 px-4 text-right">Precio / m</th>
                        <th class="py-3 px-4 text-right">Stock</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-variant font-body-sm text-body-sm">
                    <% inventario.forEach(t => { %>
                        <tr>
                            <td class="py-3 px-4 font-spec-numeral text-primary"><%= t.codigo %></td>
                            <td class="py-3 px-4 text-primary"><%= t.nombre %></td>
                            <td class="py-3 px-4 text-on-surface-variant"><%= t.fibra %></td>
                            <td class="py-3 px-4 text-right text-primary whitespace-nowrap"><%= cop(t.precio_metro) %></td>
                            <td class="py-3 px-4 text-right whitespace-nowrap">
                                <% if (t.stockBajo) { %><span class="px-2 py-0.5 text-[10px] uppercase font-semibold tracking-wider bg-error-container text-on-error-container mr-2">Bajo</span><% } %>
                                <span class="font-semibold <%= t.stockBajo ? 'text-error' : 'text-primary' %>"><%= t.stock_metros %> m</span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">
        <!-- Cuentas registradas -->
        <section id="cuentas" class="<%= seccion %>">
            <div class="flex items-start justify-between gap-4 mb-6">
                <div>
                    <h3 class="font-headline-md text-headline-md text-primary">Cuentas registradas</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant"><%= cuentas.total %> en total · <%= cuentas.nuevos30d %> nueva(s) en 30 días</p>
                </div>
                <a href="/usuarios" class="font-label-caps text-label-caps uppercase tracking-wider text-secondary hover:text-primary whitespace-nowrap"><%= esAdmin ? 'Administrar →' : 'Ver lista →' %></a>
            </div>
            <div class="grid grid-cols-3 gap-3 mb-6">
                <% [['usuario', 'Clientes'], ['moderador', 'Moderadores'], ['admin', 'Admins']].forEach(([rol, texto]) => { %>
                    <div class="bg-surface-container-lowest p-3">
                        <p class="font-label-caps text-[10px] uppercase tracking-wider text-outline"><%= texto %></p>
                        <p class="font-headline-sm text-headline-sm text-primary"><%= cuentas.conteo[rol] %></p>
                    </div>
                <% }) %>
            </div>
            <p class="font-label-caps text-label-caps uppercase tracking-widest text-outline mb-2">Últimos registros</p>
            <ul class="divide-y divide-surface-variant font-body-sm text-body-sm">
                <% cuentas.recientes.forEach(c => { %>
                    <li class="py-2.5 flex justify-between gap-3">
                        <span class="min-w-0"><span class="text-primary block truncate"><%= c.nombre %></span><span class="text-[11px] text-outline block truncate"><%= c.correo %></span></span>
                        <span class="text-right shrink-0"><span class="block text-[10px] uppercase tracking-wider text-secondary"><%= c.rol %></span><span class="text-[11px] text-outline"><%= fecha(c.created_at) %></span></span>
                    </li>
                <% }) %>
            </ul>
        </section>

        <!-- Cumplimiento Ley 1581 -->
        <section id="cumplimiento" class="<%= seccion %>">
            <h3 class="font-headline-md text-headline-md text-primary">Protección de datos</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant mb-6">Ley 1581 de 2012: autorizaciones y solicitudes de supresión.</p>
            <dl class="divide-y divide-surface-variant font-body-sm text-body-sm">
                <div class="py-3 flex justify-between gap-4"><dt class="text-on-surface-variant">Autorizaciones registradas</dt><dd class="text-primary font-semibold"><%= cumplimiento.consentimientos %></dd></div>
                <div class="py-3 flex justify-between gap-4">
                    <dt class="text-on-surface-variant">Cuentas sin autorización registrada<span class="block text-[11px] text-outline">Creadas antes de este registro o por un administrador</span></dt>
                    <dd class="<%= cumplimiento.sinConsentimiento ? 'text-error' : 'text-primary' %> font-semibold"><%= cumplimiento.sinConsentimiento %></dd>
                </div>
                <div class="py-3 flex justify-between gap-4"><dt class="text-on-surface-variant">Supresiones atendidas</dt><dd class="text-primary font-semibold"><%= cumplimiento.supresiones - cumplimiento.supresionesPendientes %></dd></div>
                <div class="py-3 flex justify-between gap-4">
                    <dt class="text-on-surface-variant">Supresiones pendientes<% if (cumplimiento.proximoVencimiento) { %><span class="block text-[11px] text-outline">Vence el <%= fecha(cumplimiento.proximoVencimiento) %></span><% } %></dt>
                    <dd class="<%= cumplimiento.supresionesPendientes ? 'text-error' : 'text-primary' %> font-semibold"><%= cumplimiento.supresionesPendientes %></dd>
                </div>
            </dl>
            <a href="/politica-datos" class="inline-block mt-4 font-label-caps text-label-caps uppercase tracking-wider text-outline hover:text-primary">Ver política publicada →</a>
        </section>
    </div>

</div>
</div>
</main>
</body>
</html>
