<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Gestión de Usuarios - TEXCOMERCE</title>
    <!-- Fuentes y Iconos oficiales -->
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&amp;family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
    <style>
      @layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}
      ::-webkit-scrollbar{display:none;}
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "surface-dim": "#dcdad4",
            "surface-container-highest": "#e5e2dc",
            "tertiary-container": "#1f1b15",
            "surface-container-low": "#f6f3ed",
            "surface": "#fcf9f3",
            "background": "#fcf9f3",
            "surface-container": "#f0eee8",
            "surface-variant": "#e5e2dc",
            "on-surface": "#1c1c18",
            "on-surface-variant": "#4b463f",
            "outline": "#7c766e",
            "outline-variant": "#cdc5bc",
            "primary": "#000000",
            "on-primary": "#ffffff",
            "secondary": "#8e4d2c",
            "on-secondary": "#ffffff",
            "error": "#ba1a1a",
            "surface-container-lowest": "#ffffff",
            "surface-container-high": "#ebe8e2"
          },
          "fontFamily": {
            "spec-numeral": ["DM Sans"],
            "headline-sm": ["Playfair Display"],
            "headline-md": ["Playfair Display"],
            "body-md": ["DM Sans"],
            "label-caps": ["DM Sans"]
          }
        }
      }
    }</script>
</head>
<body class="bg-background font-body-md text-on-surface antialiased">

    <!-- Cabecera Superior Amplia a Ancho Completo -->
    <header class="fixed top-0 left-0 right-0 h-16 bg-surface/90 backdrop-blur-md border-b border-surface-variant z-40 px-8 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <span class="font-headline-sm text-headline-sm text-primary uppercase">TEXCOMERCE</span>
            <span class="text-outline-variant">/</span>
            <a class="font-label-caps text-xs uppercase tracking-wider text-outline hover:text-primary transition-colors" href="/">← Volver al sitio</a>
            <span class="text-outline-variant">/</span>
            <span class="font-label-caps text-xs uppercase tracking-widest text-primary font-semibold">Panel de Administración</span>
        </div>
        <div class="flex items-center gap-6">
            <span class="font-body-sm text-xs text-primary font-medium">Administrador</span>
            <a href="/logout" class="font-label-caps text-xs uppercase tracking-wider text-outline hover:text-error transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">logout</span> Cerrar Sesión
            </a>
        </div>
    </header>

    <!-- Cuerpo de Contenido Expandido -->
    <main class="relative pt-24 px-8 pb-16 w-full max-w-7xl mx-auto">
        
        <!-- Título de Sección y Botón Nuevo -->
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-surface-variant">
            <div>
                <span class="font-label-caps text-xs uppercase tracking-widest text-outline">Control de Accesos</span>
                <h1 class="font-headline-md text-2xl text-primary font-semibold mt-1">Lista de Usuarios</h1>
            </div>
            <a href="/usuarios/nuevo" class="bg-primary hover:bg-secondary text-on-primary px-5 py-2.5 font-label-caps text-xs uppercase tracking-widest transition-colors shadow-sm flex items-center gap-2">
                <span class="material-symbols-outlined text-[16px]">person_add</span> + Nuevo Usuario
            </a>
        </div>

        <!-- Tabla de Usuarios con Estilo Editorial -->
        <div class="bg-surface-container-lowest border border-surface-variant shadow-sm overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-surface-variant font-label-caps text-[11px] text-outline uppercase tracking-wider">
                        <th class="py-3.5 px-6">ID</th>
                        <th class="py-3.5 px-6">Nombre</th>
                        <th class="py-3.5 px-6">Correo</th>
                        <th class="py-3.5 px-6">Rol</th>
                        <th class="py-3.5 px-6 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-variant font-body-sm text-xs">
                    <% usuarios.forEach(usuario => { %>
                        <tr class="hover:bg-surface-container-low/50 transition-colors">
                            <td class="py-4 px-6 font-spec-numeral font-semibold text-primary">#<%= usuario.id_usuario %></td>
                            <td class="py-4 px-6 font-medium text-primary"><%= usuario.nombre %></td>
                            <td class="py-4 px-6 text-on-surface-variant"><%= usuario.correo %></td>
                            <td class="py-4 px-6">
                                <span class="px-2.5 py-1 text-[10px] uppercase font-semibold tracking-wider <%= usuario.rol === 'admin' ? 'bg-primary text-on-primary' : 'bg-surface-container text-primary' %>">
                                    <%= usuario.rol %>
                                </span>
                            </td>
                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end gap-3">
                                    <a href="/usuarios/editar/<%= usuario.id_usuario %>" class="font-label-caps text-[11px] text-primary hover:text-secondary uppercase underline tracking-wider">Editar</a>
                                    <form action="/usuarios/eliminar" method="POST" style="display:inline;" onsubmit="return confirm('¿Estás seguro de eliminar este usuario?')">
                                        <input type="hidden" name="id_usuario" value="<%= usuario.id_usuario %>">
                                        <button type="submit" class="font-label-caps text-[11px] text-error hover:opacity-80 uppercase tracking-wider bg-transparent border-none cursor-pointer">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <% if (usuarios.length === 0) { %>
                <div class="p-12 text-center space-y-2">
                    <span class="material-symbols-outlined text-outline text-[32px]">group_off</span>
                    <p class="font-body-sm text-xs text-on-surface-variant">No hay usuarios registrados en la base de datos.</p>
                </div>
            <% } %>
        </div>

    </main>

</body>
</html>



