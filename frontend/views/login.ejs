<div class="fixed inset-0 bg-primary/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden transition-opacity duration-300" id="forgot-modal">
<div class="bg-surface-container-lowest max-w-md w-full p-8 shadow-xl relative animate-in fade-in zoom-in-95">
<button class="absolute top-6 right-6 text-outline hover:text-primary transition-colors" onclick="toggleForgotModal(false)">
<span class="material-symbols-outlined text-[24px]">close</span>
</button>
<div class="space-y-4">
<div class="w-10 h-10 bg-surface-container-low flex items-center justify-center text-secondary">
<span class="material-symbols-outlined text-[22px]">lock_reset</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-primary">Recuperar Contraseña</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
          Ingrese su correo electrónico y le enviaremos un enlace seguro para restablecer su contraseña.
        </p>
<form class="space-y-4 pt-2" onsubmit="handleForgotSubmit(event)">
<div class="space-y-1.5">
<label class="font-label-caps text-label-caps uppercase text-outline" for="recovery-email">Correo Registrado</label>
<div class="bg-surface-container-low px-4 py-3">
<input class="w-full bg-transparent font-body-sm text-body-sm text-on-surface outline-none" id="recovery-email" placeholder="usuario@correo.com" required="" type="email"/>
</div>
</div>
<div class="hidden p-3 bg-secondary-fixed text-on-secondary-fixed font-body-sm text-xs" id="recovery-alert">
            Enlace de restablecimiento enviado con éxito.
          </div>
<button class="w-full bg-primary hover:bg-secondary text-on-primary py-3.5 font-label-caps text-label-caps uppercase tracking-widest transition-colors" type="submit">
            Enviar Enlace
          </button>
</form>
</div>
</div>
</div>
</div>

<script>
  function switchAuthTab(tab) {
    const panels = ['login', 'register', 'admin'];
    
    panels.forEach(p => {
      const panel = document.getElementById('panel-' + p);
      const indicator = document.getElementById('indicator-' + p);
      const label = document.getElementById('label-' + p);
      
      if (p === tab) {
        panel.classList.remove('hidden');
        panel.classList.add('block');
        indicator.className = 'h-0.5 bg-primary w-full mt-2';
        label.className = 'font-label-caps text-label-caps tracking-widest uppercase transition-colors text-primary font-bold';
      } else {
        panel.classList.add('hidden');
        panel.classList.remove('block');
        indicator.className = 'h-0.5 bg-transparent w-full mt-2';
        label.className = 'font-label-caps text-label-caps tracking-widest uppercase transition-colors text-outline';
      }
    });
  }

  function togglePasswordVisibility(fieldId, buttonElement) {
    const field = document.getElementById(fieldId);
    const icon = buttonElement.querySelector('.material-symbols-outlined');
    if (field.type === 'password') {
      field.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      field.type = 'password';
      icon.textContent = 'visibility';
    }
  }

  function toggleForgotModal(show) {
    const modal = document.getElementById('forgot-modal');
    const alertBox = document.getElementById('recovery-alert');
    if (show) {
      modal.classList.remove('hidden');
      alertBox.classList.add('hidden');
    } else {
      modal.classList.add('hidden');
    }
  }

  function handleRegisterSubmit(e) {
    e.preventDefault();
    const btn = e.target.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span><span>Creando cuenta...</span>';
    
    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check_circle</span><span>Cuenta Creada</span>';
      setTimeout(() => {
        alert('Cuenta creada exitosamente. Próximamente podrá iniciar sesión.');
        switchAuthTab('login');
        btn.disabled = false;
        btn.innerHTML = '<span>Completar Registro</span><span class="material-symbols-outlined text-[18px]">how_to_reg</span>';
        e.target.reset();
      }, 1000);
    }, 1200);
  }

  function handleForgotSubmit(e) {
    e.preventDefault();
    const alertBox = document.getElementById('recovery-alert');
    alertBox.classList.remove('hidden');
    setTimeout(() => {
      toggleForgotModal(false);
    }, 2500);
  }
</script>
</main></div></body></html>
