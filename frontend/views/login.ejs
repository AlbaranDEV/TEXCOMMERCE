<!-- Cabecera Editorial & Breadcrumb Bar -->
<header class="pb-10 pt-4 max-w-7xl mx-auto w-full">
<div class="flex items-center gap-2 mb-4">
<span class="font-label-caps text-label-caps uppercase text-outline tracking-widest">Inicio</span>
<span class="text-outline-variant font-spec-numeral text-spec-numeral">/</span>
<span class="font-label-caps text-label-caps uppercase text-outline tracking-widest">Acceso al Atelier</span>
<span class="text-outline-variant font-spec-numeral text-spec-numeral">/</span>
<span class="font-label-caps text-label-caps uppercase text-secondary font-semibold tracking-widest">Acceso de Usuario</span>
</div>
<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
<div class="max-w-3xl">
<h1 class="font-display-hero text-headline-lg lg:text-display-hero text-on-surface leading-tight tracking-tight">
