<div class="space-y-2">
<label class="font-label-caps text-label-caps uppercase text-outline" for="login-email">Correo Electrónico</label>
<div class="relative bg-surface-container-low flex items-center px-4 py-3.5 focus-within:bg-surface-container-lowest transition-colors">
<span class="material-symbols-outlined text-outline text-[20px] mr-3">alternate_email</span>
<input class="w-full bg-transparent font-body-md text-body-md text-on-surface placeholder:text-outline/60 outline-none" id="login-email" name="correo" placeholder="ej. usuario@correo.com" required="" type="email"/>
</div>
</div>
<div class="space-y-2">
<div class="flex justify-between items-center">
<label class="font-label-caps text-label-caps uppercase text-outline" for="login-pass">Contraseña</label>
<button class="font-body-sm text-body-sm text-secondary hover:text-primary transition-colors underline underline-offset-4" onclick="toggleForgotModal(true)" type="button">
