<button class="group relative py-2 text-left transition-colors whitespace-nowrap" id="tab-login-btn" onclick="switchAuthTab('login')">
<span class="font-label-caps text-label-caps tracking-widest uppercase transition-colors text-primary font-bold" id="label-login">
