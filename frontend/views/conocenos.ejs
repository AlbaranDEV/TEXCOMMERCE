<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Conócenos • TEXCOMMERCE Colombia</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&amp;family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
  <style>
    @layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
    }
    ::-webkit-scrollbar { display: none; }
  </style>
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-dim": "#dcdad4",
            "surface-container-highest": "#e5e2dc",
            "tertiary-container": "#1f1b15",
            "surface-container-low": "#f6f3ed",
            "surface": "#fcf9f3",
            "tertiary-fixed-dim": "#cec5bb",
            "primary-fixed": "#e7e1dc",
            "inverse-primary": "#cbc5c0",
            "outline-variant": "#cdc5bc",
            "on-primary-fixed": "#1d1b18",
            "secondary-fixed": "#ffdbcc",
            "background": "#fcf9f3",
            "tertiary-fixed": "#eae1d7",
            "surface-container": "#f0eee8",
            "surface-tint": "#615e5a",
            "primary-container": "#1d1b18",
            "on-error": "#ffffff",
            "on-surface": "#1c1c18",
            "on-surface-variant": "#4b463f",
            "outline": "#7c766e",
            "on-secondary-fixed-variant": "#713617",
            "primary": "#000000",
            "surface-variant": "#e5e2dc",
            "secondary-fixed-dim": "#ffb694",
            "on-tertiary-container": "#8a837a",
            "on-secondary-fixed": "#351000",
            "on-tertiary-fixed-variant": "#4b463f",
            "secondary-container": "#feaa82",
            "inverse-surface": "#31312d",
            "on-tertiary": "#ffffff",
            "secondary": "#8e4d2c",
            "on-background": "#1c1c18",
            "inverse-on-surface": "#f3f0ea",
            "on-error-container": "#93000a",
            "on-primary-fixed-variant": "#494643",
            "surface-bright": "#fcf9f3",
            "on-tertiary-fixed": "#1f1b15",
            "on-secondary-container": "#793c1d",
            "error": "#ba1a1a",
            "surface-container-lowest": "#ffffff",
            "on-secondary": "#ffffff",
            "surface-container-high": "#ebe8e2",
            "primary-fixed-dim": "#cbc5c0",
            "on-primary-container": "#87837f",
            "error-container": "#ffdad6",
            "on-primary": "#ffffff",
            "tertiary": "#000000"
          },
          fontFamily: {
            "spec-numeral": ["DM Sans"],
            "display-hero": ["Playfair Display"],
            "headline-sm": ["Playfair Display"],
            "display-hero-mobile": ["Playfair Display"],
            "body-lg": ["DM Sans"],
            "headline-lg": ["Playfair Display"],
            "headline-md": ["Playfair Display"],
            "body-sm": ["DM Sans"],
            "label-caps": ["DM Sans"],
            "body-md": ["DM Sans"]
          }
        }
      }
    }
  </script>
  <script src="/cart.js"></script>
</head>
<body class="bg-background font-body-md text-on-surface antialiased selection:bg-secondary-fixed selection:text-on-secondary-fixed">

  <!-- BARRA DE NAVEGACIÓN PRINCIPAL -->
  <header class="fixed top-0 left-0 right-0 w-full z-50 bg-surface/90 backdrop-blur-md border-b border-surface-variant">
    <div class="w-full px-6 md:px-12">
      <div class="max-w-[1440px] mx-auto h-20 flex items-center justify-between gap-6">
        <nav class="hidden lg:flex items-center gap-8 font-label-caps text-xs uppercase tracking-widest" data-active-classes="text-primary font-bold border-b border-primary pb-1">
          <a class="text-on-surface-variant hover:text-primary transition-colors" data-path="inicio" href="/">Inicio</a>
          <a class="text-on-surface-variant hover:text-primary transition-colors" data-path="catalogo" href="/catalogo">Catálogo</a>
          <a aria-current="page" class="transition-colors text-primary font-bold border-b border-primary pb-1" data-path="conocenos" href="/conocenos">Conócenos</a>
          <a class="text-on-surface-variant hover:text-primary transition-colors" data-path="contacto" href="/contacto">Contacto</a>
        </nav>
        <div class="flex items-center gap-2">
          <a class="flex items-center gap-3 focus:outline-none" data-path="inicio" href="/">
            <img alt="TEXCOMERCE" class="h-8 w-auto object-contain" src="/logo.jpg"/>
            <span class="font-headline-md text-2xl tracking-tight text-primary uppercase">TEXCOMERCE</span>
          </a>
        </div>
        <div class="flex items-center gap-6">
          <a class="flex items-center gap-1 font-label-caps text-xs uppercase text-on-surface-variant hover:text-primary transition-colors" data-path="dashboard" href="/login">
            <span class="material-symbols-outlined text-[20px]">account_circle</span>
            <span class="hidden sm:inline ml-1">Mi Cuenta</span>
          </a>
          <button class="bg-primary text-on-primary px-4 py-2 font-label-caps text-xs uppercase tracking-widest hover:bg-secondary transition-colors focus:outline-none flex items-center gap-2 shadow-sm relative" onclick="window.location.href='/carrito'">
            <span>Carrito</span>
            <span class="cart-badge-count bg-on-primary text-primary px-1.5 py-0.2 rounded-full font-spec-numeral text-[10px] font-bold">(0)</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="w-full pt-28 pb-20 bg-background">
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 flex flex-col gap-20">

      <!-- HERO SECTION: IDENTIDAD Y PROPÓSITO -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center pt-4">
        <div class="lg:col-span-7 flex flex-col justify-center">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
            <span class="font-label-caps text-xs uppercase tracking-widest text-secondary font-semibold">Comercialización Textil en Colombia • 2026</span>
          </div>
          <h1 class="font-display-hero text-4xl sm:text-5xl lg:text-6xl text-primary tracking-tight leading-[1.1] mb-6">
            Materia Textil, Calidad y Venta por Metro.
          </h1>
          <p class="font-body-lg text-lg text-on-surface-variant leading-relaxed max-w-2xl mb-8">
            En <strong>TEXCOMMERCE</strong> nos dedicamos a la distribución y comercialización de telas seleccionadas a nivel nacional. Acercamos variedad de fibras y colores a confeccionistas, diseñadores, talleres de moda y creadores en toda Colombia.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="/catalogo" class="bg-primary text-on-primary px-8 py-3.5 font-label-caps text-xs uppercase tracking-widest hover:bg-secondary transition-colors shadow-sm text-center">
              Explorar Catálogo de Telas
            </a>
            <a href="/contacto" class="border border-outline-variant text-primary px-8 py-3.5 font-label-caps text-xs uppercase tracking-widest hover:bg-surface-container-high transition-colors text-center">
              Contactar Asesoría
            </a>
          </div>
        </div>
        <div class="lg:col-span-5 grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-4">
            <div class="relative overflow-hidden shadow-sm aspect-[4/5] bg-surface-container">
              <img src="/telas/denim_clasico.jpg" alt="Denim Clásico" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"/>
              <div class="absolute bottom-2 left-2 bg-surface/90 px-2 py-1 text-[11px] font-spec-numeral text-primary">Denim Clásico</div>
            </div>
            <div class="bg-surface-container-low p-4 shadow-sm flex flex-col justify-center text-center">
              <span class="font-headline-sm text-2xl text-primary font-bold">100%</span>
              <span class="font-label-caps text-[11px] text-outline uppercase tracking-wider mt-1">Venta por Metro Lineal</span>
            </div>
          </div>
          <div class="flex flex-col gap-4 pt-6">
            <div class="bg-primary text-on-primary p-4 shadow-sm flex flex-col justify-center text-center">
              <span class="font-headline-sm text-2xl font-bold">8 Tonos</span>
              <span class="font-label-caps text-[11px] text-surface-container-highest uppercase tracking-wider mt-1">Por Cada Referencia</span>
            </div>
            <div class="relative overflow-hidden shadow-sm aspect-[4/5] bg-surface-container">
              <img src="/telas/seda_natural.jpg" alt="Seda Natural" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"/>
              <div class="absolute bottom-2 left-2 bg-surface/90 px-2 py-1 text-[11px] font-spec-numeral text-primary">Seda Natural</div>
            </div>
          </div>
        </div>
      </section>

      <!-- HISTORIA, MISIÓN Y VISIÓN -->
      <section class="bg-surface-container-low p-8 md:p-14 shadow-sm">
        <div class="max-w-4xl mx-auto flex flex-col gap-12">
          
          <!-- Nuestra Historia -->
          <div>
            <div class="flex items-center gap-3 mb-3">
              <span class="font-label-caps text-xs uppercase tracking-widest text-secondary font-semibold">Nuestra Historia</span>
              <div class="h-px flex-1 bg-outline-variant/50"></div>
            </div>
            <h2 class="font-headline-lg text-3xl md:text-4xl text-primary mb-4">Compromiso con el Sector Textil</h2>
            <p class="font-body-md text-base text-on-surface-variant leading-relaxed">
              Nacimos en el año 2026 como una empresa dedicada a la comercialización de telas a nivel nacional. Desde nuestros primeros pasos, trabajamos con el compromiso de ofrecer productos de excelente calidad, apoyando a emprendedores, talleres y empresas del sector textil. Creemos en el crecimiento responsable, la innovación constante y el servicio cercano como base de nuestro desarrollo.
            </p>
          </div>

          <!-- Misión y Visión -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
            <div class="p-8 bg-surface-container-lowest shadow-sm flex flex-col justify-between border-t-2 border-primary">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-label-caps text-xs uppercase tracking-widest text-secondary font-bold">Misión</span>
                  <span class="material-symbols-outlined text-secondary text-2xl">flag</span>
                </div>
                <h3 class="font-headline-sm text-2xl text-primary mb-3">Nuestro Propósito</h3>
                <p class="font-body-sm text-sm text-on-surface-variant leading-relaxed">
                  Brindar telas de alta calidad a nivel nacional, ofreciendo variedad, precios justos y un servicio confiable que impulse el crecimiento de nuestros clientes y el desarrollo de sus proyectos de confección.
                </p>
              </div>
            </div>

            <div class="p-8 bg-surface-container-lowest shadow-sm flex flex-col justify-between border-t-2 border-secondary">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-label-caps text-xs uppercase tracking-widest text-secondary font-bold">Visión</span>
                  <span class="material-symbols-outlined text-secondary text-2xl">visibility</span>
                </div>
                <h3 class="font-headline-sm text-2xl text-primary mb-3">Hacia Dónde Vamos</h3>
                <p class="font-body-sm text-sm text-on-surface-variant leading-relaxed">
                  Ser una empresa líder en la comercialización de telas en el país, reconocida por su calidad, innovación constante y excelencia en el servicio al cliente y en los despachos a nivel nacional.
                </p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- NUESTROS COMPROMISOS -->
      <section>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="font-label-caps text-xs uppercase tracking-widest text-secondary font-semibold block mb-2">Garantía de Servicio</span>
          <h2 class="font-headline-lg text-3xl md:text-4xl text-primary">¿Por qué Elegir TEXCOMMERCE?</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <div class="p-6 bg-surface-container-lowest shadow-sm flex flex-col gap-3">
            <span class="material-symbols-outlined text-primary text-3xl">straighten</span>
            <h4 class="font-headline-sm text-xl text-primary">Venta por Metro</h4>
            <p class="font-body-sm text-xs text-on-surface-variant leading-relaxed">
              Solicita exactamente el metraje que necesitas para tus moldes o prendas, a partir de 1 metro de tela.
            </p>
          </div>

          <div class="p-6 bg-surface-container-lowest shadow-sm flex flex-col gap-3">
            <span class="material-symbols-outlined text-primary text-3xl">palette</span>
            <h4 class="font-headline-sm text-xl text-primary">8 Tonos por Tela</h4>
            <p class="font-body-sm text-xs text-on-surface-variant leading-relaxed">
              Fotografías reales de estudio en 8 colores para cada referencia, garantizando fidelidad visual.
            </p>
          </div>

          <div class="p-6 bg-surface-container-lowest shadow-sm flex flex-col gap-3">
            <span class="material-symbols-outlined text-primary text-3xl">payments</span>
            <h4 class="font-headline-sm text-xl text-primary">Precios Justos</h4>
            <p class="font-body-sm text-xs text-on-surface-variant leading-relaxed">
              Tarifas en pesos colombianos transparentes y visibles directamente por cada metro de tela.
            </p>
          </div>

          <div class="p-6 bg-surface-container-lowest shadow-sm flex flex-col gap-3">
            <span class="material-symbols-outlined text-primary text-3xl">local_shipping</span>
            <h4 class="font-headline-sm text-xl text-primary">Envíos Nacionales</h4>
            <p class="font-body-sm text-xs text-on-surface-variant leading-relaxed">
              Empaque protegido y despachos rápidos y seguros a ciudades y municipios en todo el territorio colombiano.
            </p>
          </div>

        </div>
      </section>

      <!-- SECCIÓN CLAVE: PRENDAS Y APLICACIONES POR TIPO DE TELA -->
      <section class="bg-surface-container-low p-8 md:p-14 shadow-sm">
        <div class="max-w-3xl mb-12">
          <span class="font-label-caps text-xs uppercase tracking-widest text-secondary font-semibold block mb-2">Guía de Confección &amp; Usos</span>
          <h2 class="font-headline-lg text-3xl md:text-4xl text-primary tracking-tight">
            ¿Para qué sirve cada tela y qué prendas puedes confeccionar?
          </h2>
          <p class="font-body-md text-base text-on-surface-variant mt-3 leading-relaxed">
            Descubre las características de cada una de nuestras telas del catálogo y conoce para qué tipo de proyectos, prendas y confecciones están especialmente recomendadas.
          </p>
        </div>

        <!-- REJILLA DE LAS 6 TELAS CON SUS PRENDAS REALES -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

          <!-- 1. DENIM CLÁSICO -->
          <article class="bg-surface-container-lowest shadow-sm flex flex-col overflow-hidden group hover:shadow-md transition-shadow">
            <div class="relative aspect-[4/3] overflow-hidden bg-surface-container">
              <img src="/prendas/denim_chaqueta.jpg" alt="Chaqueta de Jean en Denim Clásico" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
              <div class="absolute top-3 left-3 bg-primary text-on-primary text-[10px] font-label-caps uppercase tracking-wider px-2.5 py-1">
                Prenda Confeccionada
              </div>
              <div class="absolute bottom-3 left-3 bg-surface/90 backdrop-blur-sm px-2.5 py-1 text-xs font-spec-numeral text-primary font-bold">
                $26.000 COP / metro
              </div>
            </div>
            <div class="p-6 flex flex-col flex-1 justify-between gap-4">
              <div>
                <div class="flex items-center justify-between text-xs text-secondary font-label-caps uppercase tracking-wider mb-1">
                  <span>Código #DEN-04</span>
                  <span>100% Algodón</span>
                </div>
                <h3 class="font-headline-sm text-2xl text-primary mb-2">Denim Clásico Resistente</h3>
                <p class="font-body-sm text-xs text-on-surface-variant leading-relaxed mb-4">
                  Tela vaquera tradicional de gran durabilidad y textura estructurada. Soporta lavado constante y costuras reforzadas.
                </p>
                <div class="pt-3 border-t border-surface-variant">
                  <span class="font-label-caps text-[10px] text-outline uppercase tracking-wider block mb-2 font-bold">Prendas Recomendadas:</span>
                  <div class="flex flex-wrap gap-1.5">
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Chaquetas de Jean</span>
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Pantalones Vaqueros</span>
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Overoles</span>
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Faldas de Mezclilla</span>
                  </div>
                </div>
              </div>
              <a href="/catalogo" class="w-full text-center bg-primary text-on-primary py-2.5 font-label-caps text-xs uppercase tracking-widest hover:bg-secondary transition-colors mt-2">
                Ver Denim en Catálogo
              </a>
            </div>
          </article>

          <!-- 2. SEDA NATURAL -->
          <article class="bg-surface-container-lowest shadow-sm flex flex-col overflow-hidden group hover:shadow-md transition-shadow">
            <div class="relative aspect-[4/3] overflow-hidden bg-surface-container">
              <img src="/prendas/seda_vestido.jpg" alt="Vestido de Fiesta en Seda Natural" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
              <div class="absolute top-3 left-3 bg-primary text-on-primary text-[10px] font-label-caps uppercase tracking-wider px-2.5 py-1">
                Prenda Confeccionada
              </div>
              <div class="absolute bottom-3 left-3 bg-surface/90 backdrop-blur-sm px-2.5 py-1 text-xs font-spec-numeral text-primary font-bold">
                $45.000 COP / metro
              </div>
            </div>
            <div class="p-6 flex flex-col flex-1 justify-between gap-4">
              <div>
                <div class="flex items-center justify-between text-xs text-secondary font-label-caps uppercase tracking-wider mb-1">
                  <span>Código #SED-01</span>
                  <span>100% Seda Pura</span>
                </div>
                <h3 class="font-headline-sm text-2xl text-primary mb-2">Seda Natural Premium</h3>
                <p class="font-body-sm text-xs text-on-surface-variant leading-relaxed mb-4">
                  Tejido delicado, con una caída fluida inigualable y un brillo suave característico de la seda pura.
                </p>
                <div class="pt-3 border-t border-surface-variant">
                  <span class="font-label-caps text-[10px] text-outline uppercase tracking-wider block mb-2 font-bold">Prendas Recomendadas:</span>
                  <div class="flex flex-wrap gap-1.5">
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Vestidos de Noche</span>
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Blusas Elegantes</span>
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Pañuelos de Cuello</span>
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Lencería Fina</span>
                  </div>
                </div>
              </div>
              <a href="/catalogo" class="w-full text-center bg-primary text-on-primary py-2.5 font-label-caps text-xs uppercase tracking-widest hover:bg-secondary transition-colors mt-2">
                Ver Seda en Catálogo
              </a>
            </div>
          </article>

          <!-- 3. ALGODÓN ORGÁNICO -->
          <article class="bg-surface-container-lowest shadow-sm flex flex-col overflow-hidden group hover:shadow-md transition-shadow">
            <div class="relative aspect-[4/3] overflow-hidden bg-surface-container">
              <img src="/prendas/algodon_camiseta.jpg" alt="Camiseta en Algodón Orgánico" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
              <div class="absolute top-3 left-3 bg-primary text-on-primary text-[10px] font-label-caps uppercase tracking-wider px-2.5 py-1">
                Prenda Confeccionada
              </div>
              <div class="absolute bottom-3 left-3 bg-surface/90 backdrop-blur-sm px-2.5 py-1 text-xs font-spec-numeral text-primary font-bold">
                $24.000 COP / metro
              </div>
            </div>
            <div class="p-6 flex flex-col flex-1 justify-between gap-4">
              <div>
                <div class="flex items-center justify-between text-xs text-secondary font-label-caps uppercase tracking-wider mb-1">
                  <span>Código #ALG-06</span>
                  <span>100% Algodón</span>
                </div>
                <h3 class="font-headline-sm text-2xl text-primary mb-2">Algodón Orgánico Suave</h3>
                <p class="font-body-sm text-xs text-on-surface-variant leading-relaxed mb-4">
                  Tejido transpirable, hipoalergénico y muy suave al tacto. Ideal para prendas de contacto directo con la piel.
                </p>
                <div class="pt-3 border-t border-surface-variant">
                  <span class="font-label-caps text-[10px] text-outline uppercase tracking-wider block mb-2 font-bold">Prendas Recomendadas:</span>
                  <div class="flex flex-wrap gap-1.5">
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Camisetas Básicas</span>
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Camisas Casuales</span>
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Ropa Infantil</span>
                    <span class="bg-surface-container-high text-on-surface text-[11px] px-2 py-0.5 rounded">Pijamas Cómodas</span>
                  </div>
                </div>
              </div>
              <a href="/catalogo" class="w-full text-center bg-primary text-on-primary py-2.5 font-label-caps text-xs uppercase tracking-widest hover:bg-secondary transition-colors mt-2">
                Ver Algodón en Catálogo
              </a>
            </div>
          </article>

          <!-- 4. LYCRA DEPORTIVA -->
          <article class="bg-surface-container-lowest shadow-sm flex flex-col overflow-hidden group hover:shadow-md transition-shadow">
            <div class="relative aspect-[4/3] overflow-hidden bg-surface-container">
              <img src="/prendas/lycra_deportiva.jpg" alt="Conjunto Deportivo en Lycra Elástica" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
              <div class="absolute top-3 left-3 bg-primary text-on-primary text-[10px] font-label-caps uppercase tracking-wider px-2.5 py-1">
                Prenda Confeccionada
              </div>
              <div class="absolute bottom-3 left-3 bg-surface/90 backdrop-blur-sm px-2.5 py-1 text-xs font-spec-numeral text-primary font-bold">
                $18.500 COP / metro
              </div>
            </div>
