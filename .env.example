# Configuración de Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos MySQL
# Para desarrollo local con XAMPP:
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=texcommerce
DB_SSL=false

# Para producción en Vercel (con proveedor Cloud como Clever Cloud, Aiven, TiDB):
# DB_HOST=tu-host-cloud.com
# DB_PORT=3306
# DB_USER=tu_usuario
# DB_PASSWORD=tu_password
# DB_NAME=tu_base_datos
# DB_SSL=true
# Conexiones simultáneas a MySQL (el plan gratuito de Clever Cloud permite 5 en total)
# DB_CONNECTION_LIMIT=4

# Seguridad y Autenticación (obligatorios, mínimo 32 caracteres aleatorios y distintos entre sí).
# Genera cada uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En Vercel defínelos en Settings > Environment Variables junto con NODE_ENV=production.
JWT_SECRET=
SESSION_SECRET=
