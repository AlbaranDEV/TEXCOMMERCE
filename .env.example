# Configuración de Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos MySQL
# Para desarrollo local con XAMPP:
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=mi_base_de_datos
DB_SSL=false

# Para producción en Vercel (con proveedor Cloud como Clever Cloud, Aiven, TiDB):
# DB_HOST=tu-host-cloud.com
# DB_PORT=3306
# DB_USER=tu_usuario
# DB_PASSWORD=tu_password
# DB_NAME=tu_base_datos
# DB_SSL=true

# Seguridad y Autenticación
JWT_SECRET=clave_secreta_jwt_para_firmar_tokens_2026
SESSION_SECRET=clave_secreta_para_sesiones_express_texcommerce
